{
  "ConnectionStrings": {
    "DriverDb": "Host=localhost;Database=DriverDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "FleetDb": "Host=localhost;Database=FleetDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "RouteDb": "Host=localhost;Database=RouteDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "PlanningDb": "Host=localhost;Database=PlanningDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "OrderDb": "Host=localhost;Database=OrderDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "DeveloperDb": "Host=localhost;Database=DeveloperDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "TMS.DeveloperTool.Blazor"
    }
  },
  "AllowedHosts": "*",
  "MyRedis": {
    "ConnectionString": "localhost:6379",
    "Password": "your_secure_password",
    "Database": 2,
    "ConnectTimeout": 10000,
    "SyncTimeout": 5000,
    "AsyncTimeout": 5000,
    "ConnectRetry": 5,
    "AbortOnConnectFail": false
  },
  "MyRabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchanges": [
      {
        "Name": "vehicle_events",
        "Type": "Topic",
        "Queues": {
          "vehicles": {
            "QueueName": "vehicle_queue",
            "RoutingKey": "event.vehicle.*",
            "PrefetchCount": 20
          }
        }
      },
      {
        "Name": "pms_events",
        "Type": "direct",
        "Queues": {
          "orders": {
            "QueueName": "orders_queue",
            "RoutingKey": "event.order",
            "PrefetchCount": 5
          },
          "pickuptasks": {
            "QueueName": "pickuptasks_queue",
            "RoutingKey": "event.pickuptask",
            "PrefetchCount": 5
          }
        }
      }
    ]
  },
  "Identity": {
    "Key": "dev-signing-key-change-me",
    "Issuer": "247-Eco-System",
    "Audience": "tms-api",
    "DefaultExpiresMinutes": 480,
    "Permissions": [
      "Dashboard.Read",
      "Vehicle.Read",
      "Vehicle.Create",
      "Vehicle.Update",
      "Vehicle.Delete",
      "Vehicle.Pairing.Read",
      "Vehicle.Pairing.Update",
      "Driver.Read",
      "Driver.Create",
      "Driver.Update",
      "Driver.Delete",
      "Team.Read",
      "Team.Create",
      "Team.Update",
      "Team.Delete",
      "Route.Read",
      "Route.Create",
      "Route.Update",
      "Route.Delete",
      "Route.Import",
      "PostOffice.Read",
      "PostOffice.Create",
      "PostOffice.Update",
      "Planning.Read",
      "Planning.Create",
      "Planning.Update",
      "DailyPlan.Read",
      "PlanningTemplate.Read",
      "PlanningTemplate.Create",
      "PlanningTemplate.Update",
      "PlanningTemplate.Delete",
      "Order.Read",
      "PickupTask.Read",
      "PickupTask.Update",
      "Dispatch.Read",
      "Dispatch.Update",
      "Partner.Read",
      "Partner.Create",
      "Partner.Update",
      "Partner.Delete",
      "Pricing.Read",
      "Pricing.Create",
      "Pricing.Update",
      "Cost.Read",
      "Cost.Create",
      "Cost.Update",
      "Cost.Import",
      "Cost.Export",
      "InsurancePlan.Read",
      "InsurancePlan.Create",
      "InsurancePlan.Update",
      "MaintenancePlan.Read",
      "MaintenancePlan.Create",
      "MaintenancePlan.Update",
      "InspectionPlan.Read",
      "InspectionPlan.Create",
      "InspectionPlan.Update",
      "TruckJourney.Read",
