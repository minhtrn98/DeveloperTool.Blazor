      "Report.Read",
      "Report.Export",
      "Tracking.Read",
      "Config.Vehicle.Read",
      "Config.Vehicle.Update",
      "Config.Partner.Read",
      "Config.Partner.Update",
      "Config.Goods.Read",
      "Config.Goods.Update",
      "Config.Maintenance.Read",
      "Config.Maintenance.Update",
      "Config.Legal.Read",
      "Config.Legal.Update",
      "File.Read",
