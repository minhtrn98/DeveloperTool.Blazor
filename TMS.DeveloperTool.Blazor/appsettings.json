{
  "ConnectionStrings": {
    "DriverDb": "<<override>>",
    "FleetDb": "<<override>>",
    "RouteDb": "<<override>>",
    "PlanningDb": "<<override>>",
    "OrderDb": "<<override>>",
    "TrackingDb": "<<override>>",
    "DeveloperDb": "Host=localhost;Database=DeveloperDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "TMS.DeveloperTool.Blazor"
    }
  },
  "AllowedHosts": "*",
  "MyRedis": {
    "ConnectionString": "<<override>>",
    "Password": "<<override>>",
    "Database": 2,
    "ConnectTimeout": 10000,
    "SyncTimeout": 5000,
    "AsyncTimeout": 5000,
    "ConnectRetry": 5,
    "AbortOnConnectFail": false
  },
  "MyRabbitMq": {
    "HostName": "<<override>>",
    "UserName": "<<override>>",
    "Password": "<<override>>",
    "Port": 5672,
    "Exchanges": [
      {
        "Name": "vehicle_events",
        "Type": "Topic",
        "Queues": {
          "vehicles": {
            "QueueName": "vehicle_queue",
            "RoutingKey": "event.vehicle.*",
            "PrefetchCount": 20
          }
        }
      },
      {
        "Name": "pms_events",
        "Type": "direct",
        "Queues": {
          "orders": {
            "QueueName": "orders_queue",
            "RoutingKey": "event.order",
            "PrefetchCount": 5
          },
          "pickuptasks": {
            "QueueName": "pickuptasks_queue",
            "RoutingKey": "event.pickuptask",
            "PrefetchCount": 5
          }
        }
      }
    ]
  },
  "Identity": {
    "Key": "<<override>>",
    "Issuer": "247-Eco-System",
    "Audience": "tms-api",
    "DefaultExpiresMinutes": 480,
    "Permissions": [
      "Dashboard.Read",
      "Vehicle.Read",
      "Vehicle.Create",
      "Vehicle.Update",
      "Vehicle.Delete",
      "Vehicle.Pairing.Read",
      "Vehicle.Pairing.Update",
      "Driver.Read",
      "Driver.Create",
      "Driver.Update",
      "Driver.Delete",
      "Team.Read",
      "Team.Create",
      "Team.Update",
      "Team.Delete",
      "Route.Read",
      "Route.Create",
      "Route.Update",
      "Route.Delete",
      "Route.Import",
      "PostOffice.Read",
      "PostOffice.Create",
      "PostOffice.Update",
      "Planning.Read",
      "Planning.Create",
      "Planning.Update",
      "DailyPlan.Read",
      "PlanningTemplate.Read",
      "PlanningTemplate.Create",
      "PlanningTemplate.Update",
      "PlanningTemplate.Delete",
      "Order.Read",
      "PickupTask.Read",
      "PickupTask.Update",
      "Dispatch.Read",
      "Dispatch.Update",
      "Partner.Read",
      "Partner.Create",
      "Partner.Update",
      "Partner.Delete",
      "Pricing.Read",
      "Pricing.Create",
      "Pricing.Update",
      "Cost.Read",
      "Cost.Create",
      "Cost.Update",
      "Cost.Import",
      "Cost.Export",
      "InsurancePlan.Read",
      "InsurancePlan.Create",
      "InsurancePlan.Update",
      "MaintenancePlan.Read",
      "MaintenancePlan.Create",
      "MaintenancePlan.Update",
      "InspectionPlan.Read",
      "InspectionPlan.Create",
      "InspectionPlan.Update",
      "TruckJourney.Read",
      "DriverJourney.Read",
      "Forecast.Read",
      "Delivery.Read",
      "Delivery.Update",
      "Report.Read",
      "Report.Export",
      "Tracking.Read",
      "Config.Vehicle.Read",
      "Config.Vehicle.Update",
      "Config.Partner.Read",
      "Config.Partner.Update",
      "Config.Goods.Read",
      "Config.Goods.Update",
      "Config.Maintenance.Read",
      "Config.Maintenance.Update",
      "Config.Legal.Read",
      "Config.Legal.Update",
      "File.Read",
      "File.Upload",
      "Notification.Read",
      "Audit.Read"
    ]
  },
  "ApiUrls": {
    "Fleet": "<<override>>",
    "Driver": "<<override>>",
    "Cost": "<<override>>",
    "Route": "<<override>>",
    "Order": "<<override>>",
    "Planning": "<<override>>",
    "Tracking": "<<override>>",
    "Notification": "<<override>>",
    "Audit": "<<override>>",
    "File": "<<override>>",
    "Report": "<<override>>"
  }
