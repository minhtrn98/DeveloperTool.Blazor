{
  "ConnectionStrings": {
    "DriverDb": "Host=localhost;Database=DriverDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "FleetDb": "Host=localhost;Database=FleetDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "RouteDb": "Host=localhost;Database=RouteDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "PlanningDb": "Host=localhost;Database=PlanningDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100",
    "DeveloperDb": "Host=localhost;Database=DeveloperDB;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=10;Maximum Pool Size=100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "TMS.DeveloperTool.Blazor"
    }
  },
  "AllowedHosts": "*",
  "MyRedis": {
    "ConnectionString": "localhost:6379",
    "Password": "your_secure_password",
    "Database": 2,
    "ConnectTimeout": 10000,
    "SyncTimeout": 5000,
    "AsyncTimeout": 5000,
    "ConnectRetry": 5,
    "AbortOnConnectFail": false
  },
  "MyRabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchanges": [
      {
        "Name": "vehicle_events",
        "Type": "Topic",
        "Queues": {
          "vehicles": {
            "QueueName": "vehicle_queue",
            "RoutingKey": "event.vehicle.*",
            "PrefetchCount": 20
          }
        }
      }
    ]
  },
  "Identity": {
    "Key": "dev-signing-key-change-me",
    "Issuer": "247-Eco-System",
    "Audiences": ["hrm-api", "tms-api"],
    "DefaultExpiresMinutes": 480
  },
  "ApiUrls": {
    "Fleet": "http://localhost:10000",
    "Driver": "http://localhost:10011",
    "Cost": "http://localhost:10030",
    "Route": "http://localhost:10050",
    "Order": "http://localhost:10060",
    "Planning": "http://localhost:10070",
    "Tracking": "http://localhost:10100",
    "Notification": "http://localhost:10020",
    "Audit": "http://localhost:7083",
    "File": "http://localhost:10040",
    "Report": "http://localhost:10082"
  }
}
