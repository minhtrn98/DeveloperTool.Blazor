@using TMS.DeveloperTool.Blazor.Entities

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Chi tiết lộ trình mẫu</MudText>
    </TitleContent>
    <DialogContent>
        @if (Template != null)
        {
            <MudText Class="mb-3">
                <strong>Tên:</strong> @Template.Name
            </MudText>
            <MudText Class="mb-3">
                <strong>Thời gian nhảy:</strong> @Template.JumpSeconds giây
            </MudText>
            <MudText Typo="Typo.h6" Class="mb-3">
                Điểm kiểm tra (@Template.RouteCheckPoints.Count điểm)
            </MudText>

            @if (Template.RouteCheckPoints.Any())
            {
                <MudTable Items="@Template.RouteCheckPoints.OrderBy(cp => cp.Order)" Dense="true" Bordered="true"
                    Striped="true">
                    <HeaderContent>
                        <MudTh>Thứ tự</MudTh>
                        <MudTh>Kinh độ</MudTh>
                        <MudTh>Vĩ độ</MudTh>
                        <MudTh>Địa chỉ</MudTh>
                        <MudTh>Km</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Thứ tự">@context.Order</MudTd>
                        <MudTd DataLabel="Kinh độ">@context.Lon</MudTd>
                        <MudTd DataLabel="Vĩ độ">@context.Lat</MudTd>
                        <MudTd DataLabel="Địa chỉ">@context.Address</MudTd>
                        <MudTd DataLabel="Km">@context.Km</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Color="Color.Secondary">Không có điểm kiểm tra nào.</MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public RouteCheckPointTemplate? Template { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }
}