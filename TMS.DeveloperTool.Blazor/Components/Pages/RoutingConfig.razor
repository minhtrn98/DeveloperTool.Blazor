@page "/routing-config"
@using TMS.DeveloperTool.Blazor.Entities
@using TMS.DeveloperTool.Blazor.Services
@inject RouteCheckPointTemplateService TemplateService
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Cấu hình lộ trình mẫu</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <div class="d-flex justify-space-between mb-4">
            <MudText Typo="Typo.h4">Quản lý lộ trình mẫu</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenCreateModal">
                Thêm mới
            </MudButton>
        </div>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (templates == null || !templates.Any())
        {
            <MudAlert Severity="Severity.Info">
                Chưa có lộ trình mẫu nào. Nhấn "Thêm mới" để tạo lộ trình mẫu.
            </MudAlert>
        }
        else
        {
            <MudTable Items="@templates" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Tên</MudTh>
                    <MudTh>Thời gian nhảy (giây)</MudTh>
                    <MudTh>Số điểm kiểm tra</MudTh>
                    <MudTh>Hành động</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="STT">@(templates.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Tên">@context.Name</MudTd>
                    <MudTd DataLabel="Thời gian nhảy">@context.JumpSeconds</MudTd>
                    <MudTd DataLabel="Số điểm kiểm tra">@context.RouteCheckPoints.Count</MudTd>
                    <MudTd DataLabel="Hành động">
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small"
                                OnClick="() => ViewDetails(context)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                OnClick="() => OpenEditModal(context)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                OnClick="() => DeleteTemplate(context.Id)" />
                        </MudButtonGroup>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<RouteCheckPointTemplate> templates = new();

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        isLoading = true;
        templates = await TemplateService.GetAllAsync();
        isLoading = false;
    }

    private async Task OpenCreateModal()
    {
        List<RouteCheckPoint> defaultCheckPoints = new()
        {
            new RouteCheckPoint { Order = 1, Lon = 0, Lat = 0, Address = "Điểm dừng 1", Km = 1 },
            new RouteCheckPoint { Order = 2, Lon = 0, Lat = 0, Address = "Điểm dừng 2", Km = 2 }
        };

        DialogParameters parameters = new()
        {
            { "Template", new RouteCheckPointTemplate { JumpSeconds = 10 } },
            { "CheckPoints", defaultCheckPoints },
            { "IsEditMode", false }
        };

        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseOnEscapeKey = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<RouteTemplateFormDialog>("Tạo lộ trình mẫu mới", parameters, options);
        DialogResult? result = await dialog.Result;

        if (result?.Canceled != true)
        {
            await LoadTemplates();
        }
    }

    private async Task OpenEditModal(RouteCheckPointTemplate template)
    {
        RouteCheckPointTemplate editTemplate = RouteCheckPointTemplate.Copy(template);
        List<RouteCheckPoint> checkPoints = editTemplate.RouteCheckPoints.ToList();

        DialogParameters parameters = new()
        {
            { "Template", editTemplate },
            { "CheckPoints", checkPoints },
            { "IsEditMode", true }
        };

        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseOnEscapeKey = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<RouteTemplateFormDialog>("Chỉnh sửa lộ trình mẫu", parameters, options);
        DialogResult? result = await dialog.Result;

        if (result?.Canceled != true)
        {
            await LoadTemplates();
        }
    }

    private async Task DeleteTemplate(Guid id)
    {
        bool? result = await DialogService.ShowMessageBox(
        "Xác nhận xóa",
        "Bạn có chắc chắn muốn xóa lộ trình mẫu này?",
        yesText: "Xóa",
        cancelText: "Hủy");

        if (result == true)
        {
            await TemplateService.DeleteAsync(id);
            await LoadTemplates();
        }
    }

    private async Task ViewDetails(RouteCheckPointTemplate template)
    {
        DialogParameters parameters = new()
        {
            { "Template", template }
        };

        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };

        await DialogService.ShowAsync<RouteTemplateDetailsDialog>("Chi tiết lộ trình mẫu", parameters, options);
    }
}