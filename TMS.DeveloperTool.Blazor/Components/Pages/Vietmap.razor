@page "/vietmap"
@using TMS.DeveloperTool.Blazor.Models
@using TMS.DeveloperTool.Blazor.Services
@implements IDisposable
@rendermode InteractiveServer
@inject FleetService FleetService

<PageTitle>Vietmap</PageTitle>

<MudAutocomplete T="Guid"
    @bind-Value="Selected"
    SearchFunc="@SearchEmpty"
    ToStringFunc="@(e=> e == Guid.Empty ? "" : Vehicles[e])"
    AdornmentColor="Color.Primary"
    Variant="Variant.Outlined"
    Clearable="true"
    MaxItems="1000"
>
    <NoItemsTemplate>
        <MudText Align="Align.Center" Class="px-4 py-1">
            No items found
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@if (Selected != Guid.Empty)
{
    <p>@Vehicles[Selected]</p>
}


@code {
    private Guid Selected { get; set; } = Guid.Empty;
    private Dictionary<Guid, string> Vehicles { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Vehicles = await FleetService.GetAllVehiclePlateAsync();
    }

    protected Task<IEnumerable<Guid>> SearchEmpty(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<Guid>>(Vehicles.Keys);
        }

        return Task.FromResult(Vehicles.Where(x => x.Value.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Select(x => x.Key));
    }

    public void Dispose()
    {
    }
}
