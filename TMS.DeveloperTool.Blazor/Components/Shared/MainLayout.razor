@using TMS.DeveloperTool.Blazor.Infrastructure.Http
@using TMS.DeveloperTool.Blazor.Infrastructure.Security
@using TMS.DeveloperTool.Blazor.Infrastructure.Messaging
@using TMS.DeveloperTool.Blazor.Services
@using TMS.DeveloperTool.Blazor.Components.Dialogs
@inherits LayoutComponentBase
@implements IDisposable
@inject MyEmployeeService MyEmployeeService
@inject DriverRepository DriverRepository
@inject ISnackbar Snackbar
@inject IWebHostEnvironment WebHostEnvironment
@inject IDialogService DialogService
@inject CacheService CacheService
@inject BrowserContext BrowserContext
@inject DepartmentChangedNotifier DepartmentChangedNotifier

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false" Position="DialogPosition.Center" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">TMS DeveloperTools [@CurrentEnvironment]</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   Disabled="@(_isGeneratingTokens || _isSyncingDrivers)" StartIcon="@Icons.Material.Filled.Sync"
                   OnClick="SyncDriversAsync" Class="me-2">
            @if (_isSyncingDrivers)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <MudText>Đang đồng bộ nv</MudText>
            }
            else
            {
                <MudText>Đồng bộ nv</MudText>
            }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isGeneratingTokens || _isSyncingDrivers)"
                   StartIcon="@Icons.Material.Filled.VpnKey" OnClick="GenerateDriverTokensAsync" Class="me-2">
            @if (_isGeneratingTokens)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <MudText>Đang tạo token</MudText>
            }
            else
            {
                <MudText>Tạo token</MudText>
            }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="ShowAddDriverDialog" Class="me-2">
            <MudText>Thêm nhân viên</MudText>
        </MudButton>
        <MudStack Style="width: 400px">
            <MudAutocomplete T="DepartmentDto" Value="SelectedDepartment" ValueChanged="OnDepartmentChanged"
                             SearchFunc="SearchDepartments" ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<DepartmentDto>"
                             Label="Department" Variant="Variant.Outlined" Dense="true" Clearable="true" MaxItems="20" />
        </MudStack>
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string DefaultDepartmentCode = "K3B";
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool _isGeneratingTokens;
    private bool _isSyncingDrivers;
    private List<DepartmentDto> _departments = [];
    private DepartmentDto? _selectedDepartment;
    private MudTheme? _theme = null;
    private string CurrentEnvironment => WebHostEnvironment.EnvironmentName;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };

        try
        {
            _departments = (await DriverRepository.GetDepartmentsAsync(CancellationToken.None))
                .OrderBy(x => x.Code)
                .ThenBy(x => x.Name)
                .ToList();

            _selectedDepartment = CacheService.GetSessionDepartment(BrowserContext.BrowserId)
                ?? _departments.FirstOrDefault(x => string.Equals(x.Code, DefaultDepartmentCode, StringComparison.OrdinalIgnoreCase));

            if (_selectedDepartment is not null)
            {
                CacheService.SetSessionDepartment(BrowserContext.BrowserId, _selectedDepartment);
            }

            DepartmentChangedNotifier.OnDepartmentChanged += OnDepartmentChangedFromOtherTab;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được danh sách phòng ban: {ex.Message}", Severity.Error);
        }
    }

    private DepartmentDto? SelectedDepartment
    {
        get => _selectedDepartment;
        set => _selectedDepartment = value;
    }

    private Task OnDepartmentChanged(DepartmentDto? value)
    {
        SelectedDepartment = value;

        string browserId = BrowserContext.BrowserId ?? string.Empty;
        if (value is not null)
        {
            CacheService.SetSessionDepartment(browserId, value);
        }
        else
        {
            CacheService.RemoveSessionDepartment(browserId);
        }

        DepartmentChangedNotifier.Notify(browserId, value);

        return Task.CompletedTask;
    }

    private void OnDepartmentChangedFromOtherTab(string browserId, DepartmentDto? department)
    {
        if (browserId != (BrowserContext.BrowserId ?? string.Empty))
        {
            return;
        }

        // Event fires on a thread-pool thread — must marshal back to the circuit
        InvokeAsync(() =>
        {
            _selectedDepartment = department;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DepartmentChangedNotifier.OnDepartmentChanged -= OnDepartmentChangedFromOtherTab;
    }

    private Task<IEnumerable<DepartmentDto>> SearchDepartments(string value, CancellationToken cancellationToken)
    {
        IEnumerable<DepartmentDto> results = AutocompleteSearchHelper.SearchByLike(_departments, value);
        return Task.FromResult(results);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private async Task ShowAddDriverDialog()
    {
        var dialog = await DialogService.ShowAsync<AddDriverDialog>();
        var result = await dialog.Result;
    }

    private async Task GenerateDriverTokensAsync()
    {
        if (_isGeneratingTokens || _isSyncingDrivers)
        {
            return;
        }

        _isGeneratingTokens = true;
        try
        {
            int updatedCount = await MyEmployeeService.GenerateTokensForAllEmployeesAsync();
            if (updatedCount == 0)
            {
                Snackbar.Add("Tất cả tài xế đã có token.", Severity.Info);
                return;
            }
            Snackbar.Add($"Đã tạo token cho {updatedCount} tài xế.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tạo được token: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGeneratingTokens = false;
        }
    }

    private async Task SyncDriversAsync()
    {
        if (_isGeneratingTokens || _isSyncingDrivers)
        {
            return;
        }

        _isSyncingDrivers = true;
        try
        {
            int insertedCount = await MyEmployeeService.SyncMissingEmployeesFromPickupTaskAsync();
            if (insertedCount == 0)
            {
                Snackbar.Add("Không có tài xế mới để đồng bộ.", Severity.Info);
                return;
            }

            Snackbar.Add($"Đã đồng bộ {insertedCount} tài xế.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không đồng bộ được tài xế: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncingDrivers = false;
        }
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}