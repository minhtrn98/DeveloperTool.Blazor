@using TMS.DeveloperTool.Blazor.Services

@inherits MudTextField<string>
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ApiRequestBodyFormatterService BodyFormatter

<div class="@Class">
    <MudTextField T="string"
                  Value="_innerValue"
                  ValueChanged="OnValueChanged"
                  Label="@Label"
                  Variant="@Variant"
                  FullWidth="@FullWidth"
                  ReadOnly="@ReadOnly"
                  Lines="@Lines"
                  AutoGrow="@AutoGrow" />

    <div class="d-flex justify-end ga-1 mt-1">
        @if (ShowFormatButton)
        {
            <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="FormatJsonAsync" />
        }
        @if (ShowCopyButton)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           OnClick="CopyValueAsync" />
        }
    </div>
</div>

@code {
    private string _innerValue = string.Empty;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _innerValue = Value ?? string.Empty;
    }

    /// <summary>
    /// Gets or sets whether action buttons are disabled when the value is empty.
    /// </summary>
    [Parameter]
    public bool DisableButtonsWhenEmpty { get; init; } = true;

    /// <summary>
    /// Gets or sets whether the format button is visible.
    /// </summary>
    [Parameter]
    public bool ShowFormatButton { get; init; } = true;

    /// <summary>
    /// Gets or sets whether the copy button is visible.
    /// </summary>
    [Parameter]
    public bool ShowCopyButton { get; init; } = true;

    private async Task OnValueChanged(string? value)
    {
        string newValue = value ?? string.Empty;
        _innerValue = newValue;
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

    private async Task FormatJsonAsync()
    {
        if (!ShowFormatButton)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Value))
        {
            Snackbar.Add("JSON is empty.", Severity.Warning);
            return;
        }

        try
        {
            string formatted = BodyFormatter.NormalizeAndFormatJson(Value);
            _innerValue = formatted;
            Value = formatted;
            await ValueChanged.InvokeAsync(formatted);
            Snackbar.Add("JSON formatted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot format JSON: {ex.Message}", Severity.Warning);
        }
    }

    private async Task CopyValueAsync()
    {
        if (!ShowCopyButton)
        {
            return;
        }

        string value = Value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(value))
        {
            Snackbar.Add("Nothing to copy.", Severity.Warning);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add("Copied to clipboard.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot copy text: {ex.Message}", Severity.Error);
        }
    }
}