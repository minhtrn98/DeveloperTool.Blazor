@using System.Net
@using System.Net.Sockets
@using TMS.DeveloperTool.Blazor.Infrastructure.Constants
@inject IWebHostEnvironment WebHostEnvironment
@inject IHttpContextAccessor HttpContextAccessor
@inject MenuVisibilityOptions MenuVisibilityOptions

<MudNavMenu>
    @if (ShouldShow(ApplicationConstants.MenuKeys.Home))
    {
        <MudNavLink Href="@ApplicationConstants.Routes.Home" Match="NavLinkMatch.All">Trang chủ</MudNavLink>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.Pairing) ||
        ShouldShow(ApplicationConstants.MenuKeys.ConfirmSwap) ||
        ShouldShow(ApplicationConstants.MenuKeys.SimulateRoute))
    {
        <MudNavGroup Title="Ghép xe" Expanded="false">
            @if (ShouldShow(ApplicationConstants.MenuKeys.Pairing))
            {
                <MudNavLink Href="@ApplicationConstants.Routes.Pairing" Match="NavLinkMatch.All">Ghép xe</MudNavLink>
            }
            @if (ShouldShow(ApplicationConstants.MenuKeys.ConfirmSwap))
            {
                <MudNavLink Href="@ApplicationConstants.Routes.PairingConfirmSwap" Match="NavLinkMatch.All">Yêu cầu đổi tài
                </MudNavLink>
            }
            @if (ShouldShow(ApplicationConstants.MenuKeys.SimulateRoute))
            {
                <MudNavLink Href="@ApplicationConstants.Routes.SimulateRoute" Match="NavLinkMatch.All">Mô phỏng lộ trình
                </MudNavLink>
            }
        </MudNavGroup>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.PickupTasks) ||
        ShouldShow(ApplicationConstants.MenuKeys.CreatePickupTaskEvent))
    {
        <MudNavGroup Title="Điều tin" Expanded="false">
            @if (ShouldShow(ApplicationConstants.MenuKeys.PickupTasks))
            {
                <MudNavLink Href="@ApplicationConstants.Routes.PickupTasks" Match="NavLinkMatch.All">Danh sách</MudNavLink>
            }
            @if (ShouldShow(ApplicationConstants.MenuKeys.CreatePickupTaskEvent))
            {
                <MudNavLink Href="@ApplicationConstants.Routes.PickupTasksCreateEvent" Match="NavLinkMatch.All">Tạo điều tin
                </MudNavLink>
            }
        </MudNavGroup>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.Manifests))
    {
        <MudNavGroup Title="Sổ phát" Expanded="false">
            <MudNavLink Href="@ApplicationConstants.Routes.ManifestList" Match="NavLinkMatch.All">Danh sách sổ phát</MudNavLink>
            <MudNavLink Href="@ApplicationConstants.Routes.ManifestOrders" Match="NavLinkMatch.All">Đơn hàng</MudNavLink>
        </MudNavGroup>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.TopMovingVehicles))
    {
        <MudNavLink Href="@ApplicationConstants.Routes.TopMovingVehicles" Match="NavLinkMatch.All">Top xe di chuyển
        </MudNavLink>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.VehicleStatuses))
    {
        <MudNavLink Href="@ApplicationConstants.Routes.VehicleStatuses" Match="NavLinkMatch.All">Theo dõi trạng thái xe
        </MudNavLink>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.LenHang))
    {
        <MudNavGroup Title="Lên hàng" Expanded="false">
            <MudNavLink Href="@ApplicationConstants.Routes.LenHangChuyenThu" Match="NavLinkMatch.All">Chuyến thư</MudNavLink>
        </MudNavGroup>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.ApiRequest))
    {
        <MudNavLink Href="@ApplicationConstants.Routes.ApiRequest" Match="NavLinkMatch.All">API Request</MudNavLink>
    }

    @if (ShouldShow(ApplicationConstants.MenuKeys.RoutingConfig))
    {
        <MudNavGroup Title="Cấu hình" Expanded="false">
            <MudNavLink Href="@ApplicationConstants.Routes.RoutingConfig" Match="NavLinkMatch.All">Lộ trình mẫu</MudNavLink>
        </MudNavGroup>
    }
</MudNavMenu>

    @code {
    private readonly string[] _allMenuKeys =
    [
        ApplicationConstants.MenuKeys.Home,
        ApplicationConstants.MenuKeys.Pairing,
        ApplicationConstants.MenuKeys.ConfirmSwap,
        ApplicationConstants.MenuKeys.SimulateRoute,
        ApplicationConstants.MenuKeys.PickupTasks,
        ApplicationConstants.MenuKeys.CreatePickupTaskEvent,
        ApplicationConstants.MenuKeys.TopMovingVehicles,
        ApplicationConstants.MenuKeys.VehicleStatuses,
        ApplicationConstants.MenuKeys.RoutingConfig,
        ApplicationConstants.MenuKeys.ApiRequest,
        ApplicationConstants.MenuKeys.Manifests,
        ApplicationConstants.MenuKeys.LenHang
    ];

    private HashSet<string> _allowedMenusForCurrentRequest = new (StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        bool isLocal = WebHostEnvironment.IsEnvironment(ApplicationConstants.EnvironmentNames.Local);
        bool isLocalRequest = IsLocalRequest();

        string[] allowedMenuList = (isLocal, isLocalRequest) switch
        {
            (true, false) => MenuVisibilityOptions.LocalNonLocalIpVisibleMenus,
            _ => _allMenuKeys
        };

        _allowedMenusForCurrentRequest = new HashSet<string>(allowedMenuList, StringComparer.OrdinalIgnoreCase);
    }

    private bool ShouldShow(string menuKey)
    {
        return _allowedMenusForCurrentRequest.Contains(menuKey);
    }

    private bool IsLocalRequest()
    {
        IPAddress? remoteIp = ResolveClientIpAddress();
        if (remoteIp is null)
        {
            return false;
        }

        remoteIp = NormalizeIp(remoteIp);
        if (IPAddress.IsLoopback(remoteIp))
        {
            return true;
        }

        foreach (IPAddress serverIp in GetServerIpAddresses())
        {
            if (NormalizeIp(serverIp).Equals(remoteIp))
            {
                return true;
            }
        }

        return false;
    }

    private IPAddress? ResolveClientIpAddress()
    {
        HttpContext? context = HttpContextAccessor.HttpContext;
        if (context is null)
        {
            return null;
        }

        string? forwardedFor = context.Request.Headers[ApplicationConstants.HttpHeaders.XForwardedFor].FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(forwardedFor))
        {
            string candidate = forwardedFor.Split(',')[0].Trim();
            if (IPAddress.TryParse(candidate, out IPAddress? forwardedIp))
            {
                return forwardedIp;
            }
        }

        return context.Connection.RemoteIpAddress;
    }

    private static IPAddress NormalizeIp(IPAddress ip)
    {
        return ip.IsIPv4MappedToIPv6 ? ip.MapToIPv4() : ip;
    }

    private static IEnumerable<IPAddress> GetServerIpAddresses()
    {
        IPAddress[] hostAddresses = Dns.GetHostAddresses(Dns.GetHostName());
        foreach (IPAddress address in hostAddresses)
        {
            if (address.AddressFamily is AddressFamily.InterNetwork or AddressFamily.InterNetworkV6)
            {
                yield return address;
            }
        }

        yield return IPAddress.Loopback;
        yield return IPAddress.IPv6Loopback;
    }
}