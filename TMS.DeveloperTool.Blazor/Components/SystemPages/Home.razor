@page "/"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<PageTitle>Trang chủ</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-2">TMS DeveloperTools</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">Chọn chức năng</MudText>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/pairing">Ghép xe</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/pairing/confirm-swap">Xác nhận đổi tài</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/simulate-route">Mô phỏng lộ trình</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
