@using TMS.DeveloperTool.Blazor.Features.Routing.Models
@using TMS.DeveloperTool.Blazor.Features.Routing.Services
@inject RouteCheckPointTemplateService TemplateService
@inject RouteRepository RouteService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Chỉnh sửa lộ trình mẫu" : "Tạo lộ trình mẫu mới")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Template.Name" AutoFocus Label="Tên lộ trình" Variant="Variant.Outlined"
            FullWidth="true" Class="mb-4" />

        <MudNumericField @bind-Value="Template.JumpSeconds" Label="Thời gian nhảy (giây)" Variant="Variant.Outlined"
            FullWidth="true" Class="mb-4" Min="2" Error="Template.JumpSeconds < 2"
            ErrorText="Thời gian nhảy phải lớn hơn 1 giây" />

        <div class="d-flex justify-space-between mb-3">
            <MudText Typo="Typo.h6">Điểm dừng</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                StartIcon="@Icons.Material.Filled.Add" OnClick="AddCheckPoint">
                Thêm điểm dừng
            </MudButton>
        </div>

        @if (!CheckPoints.Any())
        {
            <MudAlert Severity="Severity.Warning">
                Chưa có điểm dừng nào. Vui lòng thêm ít nhất 2 điểm dừng.
            </MudAlert>
        }
        else
        {
            <MudTable Items="@CheckPoints" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Thứ tự</MudTh>
                    <MudTh>Bưu cục</MudTh>
                    <MudTh>Tọa độ (Lat, Lon)</MudTh>
                    <MudTh>Địa chỉ</MudTh>
                    <MudTh>Km</MudTh>
                    <MudTh>Hành động</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Thứ tự">
                        <MudText>@context.Order</MudText>
                    </MudTd>
                    <MudTd DataLabel="Bưu cục">
                        <MudAutocomplete T="PostOffice"
                            MaxItems="100"
                            Value="@(GetSelectedPostOffice(context))"
                            ValueChanged="@(postOffice => OnPostOfficeSelected(context, postOffice))"
                            SearchFunc="@SearchPostOffices"
                            ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<PostOffice>"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            Clearable="true"
                            Placeholder="Mã hoặc tên bưu cục" />
                    </MudTd>
                    <MudTd DataLabel="Tọa độ (Lat, Lon)">
                        <MudTextField Value="@GetCoordinateString(context)"
                            ValueChanged="@((string value) => ParseCoordinates(context, value))"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            Placeholder="10.818135, 106.757819" />
                    </MudTd>
                    <MudTd DataLabel="Địa chỉ">
                        <MudTextField @bind-Value="context.Address" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="Km">
                        <MudNumericField @bind-Value="context.Km" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1"
                            Error="context.Km < 1" ErrorText="Km phải lớn hơn hoặc bằng 1" />
                    </MudTd>
                    <MudTd DataLabel="Hành động">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                            OnClick="() => RemoveCheckPoint(CheckPoints.IndexOf(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (!string.IsNullOrEmpty(validationMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@validationMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Hủy</MudButton>
        <MudButton OnClick="SaveTemplate" Variant="Variant.Filled" Color="Color.Primary">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public RouteCheckPointTemplate Template { get; set; } = new();

    [Parameter]
    public List<RouteCheckPoint> CheckPoints { get; set; } = new();

    [Parameter]
    public bool IsEditMode { get; set; }

    private string validationMessage = string.Empty;
    private List<PostOffice> postOffices = new();
    private Dictionary<RouteCheckPoint, PostOffice?> selectedPostOffices = new();

    protected override async Task OnInitializedAsync()
    {
        postOffices = (await RouteService.GetPostOfficesAsync()).ToList();
    }

    private void AddCheckPoint()
    {
        int nextOrder = CheckPoints.Any() ? CheckPoints.Max(cp => cp.Order) + 1 : 1;
        CheckPoints.Add(new RouteCheckPoint
        {
            Order = nextOrder,
            Lon = 0,
            Lat = 0,
            Address = string.Empty,
            Km = 1
        });
    }

    private void RemoveCheckPoint(int index)
    {
        CheckPoints.RemoveAt(index);
        // Reorder remaining checkpoints
        for (int i = 0; i < CheckPoints.Count; i++)
        {
            CheckPoints[i].Order = i + 1;
        }
    }

    private string GetCoordinateString(RouteCheckPoint checkPoint)
    {
        if (checkPoint.Lat == 0 && checkPoint.Lon == 0)
        {
            return string.Empty;
        }
        return $"{checkPoint.Lat}, {checkPoint.Lon}";
    }

    private void ParseCoordinates(RouteCheckPoint checkPoint, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            checkPoint.Lat = 0;
            checkPoint.Lon = 0;
            return;
        }

        string[] parts = value.Split(',', StringSplitOptions.TrimEntries);
        if (parts.Length == 2)
        {
            if (double.TryParse(parts[0], out double lat))
            {
                checkPoint.Lat = lat;
            }
            if (double.TryParse(parts[1], out double lon))
            {
                checkPoint.Lon = lon;
            }
        }
    }

    private async Task SaveTemplate()
    {
        validationMessage = string.Empty;

        // validate Name not null or empty
        if (string.IsNullOrWhiteSpace(Template.Name))
        {
            validationMessage = "Tên lộ trình không được để trống.";
            return;
        }

        // Validation JumpSeconds
        if (Template.JumpSeconds < 2)
        {
            validationMessage = "Thời gian nhảy phải lớn hơn 1 giây.";
            return;
        }

        // Validation for minimum checkpoints
        if (CheckPoints.Count < 2)
        {
            validationMessage = "Vui lòng thêm ít nhất 2 điểm dừng.";
            return;
        }

        // Validation for empty address
        if (CheckPoints.Any(cp => string.IsNullOrWhiteSpace(cp.Address)))
        {
            validationMessage = "Vui lòng điền địa chỉ cho tất cả các điểm dừng.";
            return;
        }

        // Validation for Km > 1
        if (CheckPoints.Any(cp => cp.Km < 1))
        {
            validationMessage = "Km phải lớn hơn hoặc bằng 1 cho tất cả các điểm dừng.";
            return;
        }

        Template.RouteCheckPoints = CheckPoints;

        try
        {
            if (IsEditMode)
            {
                await TemplateService.UpdateAsync(Template);
            }
            else
            {
                await TemplateService.CreateAsync(Template);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            validationMessage = $"Lỗi: {ex.Message}";
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private Task<IEnumerable<PostOffice>> SearchPostOffices(string value, CancellationToken cancellationToken)
    {
        IEnumerable<PostOffice> results = AutocompleteSearchHelper.SearchByLike(postOffices, value);
        return Task.FromResult(results);
    }

    private PostOffice? GetSelectedPostOffice(RouteCheckPoint checkPoint)
    {
        return selectedPostOffices.TryGetValue(checkPoint, out PostOffice? postOffice) ? postOffice : null;
    }

    private void OnPostOfficeSelected(RouteCheckPoint checkPoint, PostOffice? postOffice)
    {
        selectedPostOffices[checkPoint] = postOffice;

        if (postOffice == null)
        {
            return;
        }

        checkPoint.Lat = postOffice.Latitude;
        checkPoint.Lon = postOffice.Longitude;
        checkPoint.Address = postOffice.StreetAddress ?? string.Empty;
    }
}