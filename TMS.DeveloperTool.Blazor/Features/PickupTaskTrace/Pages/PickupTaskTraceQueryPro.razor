@page "/pro/pickup-task-trace-query"
@using TMS.DeveloperTool.Blazor.Features.PickupTaskTrace.Models
@using TMS.DeveloperTool.Blazor.Features.PickupTaskTrace.Services
@inject PickupTaskProTraceLogStorageService StorageService

<AppPageTitle MenuName="Pro - Điều tin" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-4">Pro - Điều tin - Tra cứu log</MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="PickupTaskIdOption" Value="selectedPickupTask" ValueChanged="OnPickupTaskSelectedAsync"
                                 SearchFunc="SearchPickupTaskIds" Label="Mã điều tin" Variant="Variant.Outlined"
                                 Clearable="true" MaxItems="20"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<PickupTaskIdOption>" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="DeliveryLineIdOption" Value="selectedDeliveryLine" ValueChanged="OnDeliveryLineSelectedAsync"
                                 SearchFunc="SearchDeliveryLineIds" Label="Delivery Line Id" Variant="Variant.Outlined"
                                 Clearable="true" MaxItems="20"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<DeliveryLineIdOption>" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-4">
        <TraceLogTable TItem="PickupTaskTraceLog" @ref="traceTable" LoadDataAsync="LoadDataAsync">
            <TableHeader>
                <MudTh>STT</MudTh>
                <MudTh>Thời gian</MudTh>
                <MudTh>Mã điều tin</MudTh>
                <MudTh>Dispatch Type</MudTh>
                <MudTh>Dispatch Method</MudTh>
                <MudTh>Pms Status Id</MudTh>
                <MudTh>Total Items</MudTh>
                <MudTh>Total Weight</MudTh>
                <MudTh>Delivery Line Id</MudTh>
                <MudTh>Pick Effort Type</MudTh>
                <MudTh>Trace Id</MudTh>
                <MudTh>Message Detail</MudTh>
            </TableHeader>
            <TableRow Context="row">
                @{ PickupTaskMessageFields fields = PickupTaskMessageFieldsParser.Parse(row.Item.MessageDetail); }
                <MudTd DataLabel="STT">@row.Index</MudTd>
                <MudTd DataLabel="Thời gian">@row.Item.LogTimestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                <MudTd DataLabel="Mã điều tin">@row.Item.PickupTaskId</MudTd>
                <MudTd DataLabel="Dispatch Type">@fields.DispatchType</MudTd>
                <MudTd DataLabel="Dispatch Method">@fields.DispatchMethod</MudTd>
                <MudTd DataLabel="Pms Status Id">@fields.PmsStatusId</MudTd>
                <MudTd DataLabel="Total Items">@fields.TotalItems</MudTd>
                <MudTd DataLabel="Total Weight">@fields.TotalWeight</MudTd>
                <MudTd DataLabel="Delivery Line Id">@fields.DeliveryLineId</MudTd>
                <MudTd DataLabel="Pick Effort Type">@fields.PickEffortType</MudTd>
                <MudTd DataLabel="Trace Id">@row.Item.TraceId</MudTd>
                <MudTd DataLabel="Message Detail">
                    <CopyMessageDetailButton MessageDetail="@row.Item.MessageDetail" />
                </MudTd>
            </TableRow>
        </TraceLogTable>
    </MudPaper>
</MudContainer>

@code {
    private List<PickupTaskIdOption> pickupTaskIdOptions = [];
    private List<DeliveryLineIdOption> deliveryLineIdOptions = [];
    private PickupTaskIdOption? selectedPickupTask;
    private DeliveryLineIdOption? selectedDeliveryLine;
    private TraceLogTable<PickupTaskTraceLog>? traceTable;

    protected override async Task OnInitializedAsync()
    {
        List<string> ids = await StorageService.GetDistinctPickupTaskIdsAsync(CancellationToken.None);
        pickupTaskIdOptions = ids.Select(id => new PickupTaskIdOption(id)).ToList();

        List<string> deliveryLineIds = await StorageService.GetDistinctDeliveryLineIdsAsync(CancellationToken.None);
        deliveryLineIdOptions = deliveryLineIds.Select(id => new DeliveryLineIdOption(id)).ToList();
    }

    private Task<IEnumerable<PickupTaskIdOption>> SearchPickupTaskIds(string searchTerm, CancellationToken cancellationToken)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(pickupTaskIdOptions, searchTerm));

    private Task<IEnumerable<DeliveryLineIdOption>> SearchDeliveryLineIds(string searchTerm, CancellationToken cancellationToken)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(deliveryLineIdOptions, searchTerm));

    private async Task OnPickupTaskSelectedAsync(PickupTaskIdOption? value)
    {
        selectedPickupTask = value;
        await ReloadAsync();
    }

    private async Task OnDeliveryLineSelectedAsync(DeliveryLineIdOption? value)
    {
        selectedDeliveryLine = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (traceTable is not null)
        {
            await traceTable.ReloadAsync();
        }
    }

    private Task<(List<PickupTaskTraceLog> Items, int TotalCount)> LoadDataAsync(int page, int pageSize, CancellationToken cancellationToken)
        => StorageService.QueryAsync(selectedPickupTask?.PickupTaskId, selectedDeliveryLine?.DeliveryLineId, page, pageSize, cancellationToken);
}
