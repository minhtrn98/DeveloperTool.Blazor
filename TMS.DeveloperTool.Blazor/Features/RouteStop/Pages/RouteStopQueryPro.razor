@page "/pro/route-stop-query"
@using TMS.DeveloperTool.Blazor.Features.RouteStop.Models
@using TMS.DeveloperTool.Blazor.Features.RouteStop.Services
@inject RouteStopProTraceLogStorageService StorageService
@inject FleetRepository FleetRepository

<AppPageTitle MenuName="Pro - Route Stop" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-4">Pro - Route Stop - Tra cứu log</MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="VehicleLookupDto" Value="selectedVehicle" ValueChanged="OnVehicleSelectedAsync"
                                 SearchFunc="SearchVehicles" Label="Biển số xe (ActualPlate)" Variant="Variant.Outlined"
                                 Clearable="true" MaxItems="20"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<VehicleLookupDto>" />
                @if (selectedVehicle is not null)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">Vehicle Id: @selectedVehicle.Id</MudText>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="ActionObjectIdOption" Value="selectedActionObject" ValueChanged="OnActionObjectSelectedAsync"
                                 SearchFunc="SearchActionObjectIds" Label="Action Object Id" Variant="Variant.Outlined"
                                 Clearable="true" MaxItems="20"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<ActionObjectIdOption>" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-4">
        <TraceLogTable TItem="RouteStopTraceLog" @ref="traceTable" LoadDataAsync="LoadDataAsync">
            <TableHeader>
                <MudTh>STT</MudTh>
                <MudTh>Thời gian</MudTh>
                <MudTh>Action</MudTh>
                <MudTh>Driver</MudTh>
                <MudTh>License Plate</MudTh>
                <MudTh>Assignment Code</MudTh>
                <MudTh>Item Count</MudTh>
                <MudTh>Weight</MudTh>
                <MudTh>Action Object Id</MudTh>
                <MudTh>Full Pending</MudTh>
                <MudTh>Mark Completed</MudTh>
                <MudTh>Trace Id</MudTh>
                <MudTh>Message Detail</MudTh>
            </TableHeader>
            <TableRow Context="row">
                @{ RouteStopMessageFields fields = RouteStopMessageFieldsParser.Parse(row.Item.MessageDetail); }
                <MudTd DataLabel="STT">@row.Index</MudTd>
                <MudTd DataLabel="Thời gian">@VietnamTimeHelper.Format(row.Item.LogTimestamp)</MudTd>
                <MudTd DataLabel="Action">@row.Item.Action</MudTd>
                <MudTd DataLabel="Driver">
                    @fields.DriverName
                    <br />
                    @row.Item.Driver
                </MudTd>
                <MudTd DataLabel="License Plate">@fields.VehicleLicensePlate</MudTd>
                <MudTd DataLabel="Assignment Code">@GetAssignmentCode(row.Item.AssignmentId)</MudTd>
                <MudTd DataLabel="Item Count">@fields.ItemCount</MudTd>
                <MudTd DataLabel="Weight">@fields.Weight</MudTd>
                <MudTd DataLabel="Action Object Id">@row.Item.ActionObjectId</MudTd>
                <MudTd DataLabel="Full Pending">@fields.IsFullPending</MudTd>
                <MudTd DataLabel="Mark Completed">@fields.MarkStopCompleted</MudTd>
                <MudTd DataLabel="Trace Id">@row.Item.TraceId</MudTd>
                <MudTd DataLabel="Message Detail">
                    <CopyMessageDetailButton MessageDetail="@row.Item.MessageDetail" />
                </MudTd>
            </TableRow>
        </TraceLogTable>
    </MudPaper>
</MudContainer>

@code {
    private List<VehicleLookupDto> vehicleOptions = [];
    private List<ActionObjectIdOption> actionObjectIdOptions = [];
    private Dictionary<Guid, string> assignmentCodeById = [];
    private VehicleLookupDto? selectedVehicle;
    private ActionObjectIdOption? selectedActionObject;
    private TraceLogTable<RouteStopTraceLog>? traceTable;

    protected override async Task OnInitializedAsync()
    {
        List<Guid> vehicleIds = await StorageService.GetDistinctVehicleIdsAsync(CancellationToken.None);
        if (vehicleIds.Count > 0)
        {
            vehicleOptions = await FleetRepository.GetVehiclesByIdsAsync(vehicleIds);
        }

        List<string> actionObjectIds = await StorageService.GetDistinctActionObjectIdsAsync(CancellationToken.None);
        actionObjectIdOptions = actionObjectIds.Select(id => new ActionObjectIdOption(id)).ToList();

        // Assignment Code is still shown as a column, so Assignment Ids are still looked up —
        // just no longer exposed as a filter (see task that removed the Assignment filter).
        List<Guid> assignmentIds = await StorageService.GetDistinctAssignmentIdsAsync(CancellationToken.None);
        if (assignmentIds.Count > 0)
        {
            List<AssignmentLookupDto> assignments = await FleetRepository.GetAssignmentsByIdsAsync(assignmentIds);
            assignmentCodeById = assignments.ToDictionary(a => a.Id, a => a.Code);
        }
    }

    private string GetAssignmentCode(string assignmentId)
    {
        return Guid.TryParse(assignmentId, out Guid id) && assignmentCodeById.TryGetValue(id, out string? code)
            ? code
            : string.Empty;
    }

    private Task<IEnumerable<VehicleLookupDto>> SearchVehicles(string searchTerm, CancellationToken cancellationToken)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(vehicleOptions, searchTerm));

    private Task<IEnumerable<ActionObjectIdOption>> SearchActionObjectIds(string searchTerm, CancellationToken cancellationToken)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(actionObjectIdOptions, searchTerm));

    private async Task OnVehicleSelectedAsync(VehicleLookupDto? value)
    {
        selectedVehicle = value;
        await ReloadAsync();
    }

    private async Task OnActionObjectSelectedAsync(ActionObjectIdOption? value)
    {
        selectedActionObject = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (traceTable is not null)
        {
            await traceTable.ReloadAsync();
        }
    }

    private Task<(List<RouteStopTraceLog> Items, int TotalCount)> LoadDataAsync(int page, int pageSize, CancellationToken cancellationToken)
        => StorageService.QueryAsync(selectedVehicle?.Id.ToString(), selectedActionObject?.ActionObjectId, page, pageSize, cancellationToken);
}
