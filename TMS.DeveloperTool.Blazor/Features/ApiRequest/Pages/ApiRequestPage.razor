@page "/api-request"
@using System.Diagnostics
@using System.Net.Http.Headers
@using System.Text.Encodings.Web
@using System.Text
@using System.Text.Json
@using TMS.DeveloperTool.Blazor.Features.ApiRequest.Services
@using TMS.DeveloperTool.Blazor.Services
@using TMS.DeveloperTool.Blazor.Infrastructure.Security
@inject IHttpClientFactory HttpClientFactory
@inject MyEmployeeService MyEmployeeService
@inject ApiRequestHistoryService ApiRequestHistoryService
@inject ApiRequestBodyFormatterService ApiRequestBodyFormatterService
@inject ApiRequestSwaggerService ApiRequestSwaggerService
@inject ApiUrlsOptions ApiUrlsOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject CacheService CacheService
@inject BrowserContext BrowserContext

<AppPageTitle MenuName="API Request" />

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4 request-panel">
                <MudText Typo="Typo.h5" Class="mb-4">Request</MudText>

                <MudPaper Outlined="true" Class="pa-3 mb-3 swagger-panel">
                    <div class="d-flex flex-wrap align-center justify-space-between ga-2 mb-3">
                        <MudText Typo="Typo.subtitle2">Swagger Endpoint</MudText>
                        <MudText Typo="Typo.caption">@swaggerStatusText</MudText>
                    </div>

                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="selectedService" Label="Service" Variant="Variant.Outlined"
                                       FullWidth="true" @bind-Value:after="OnServiceChanged">
                                @foreach (ServiceOption service in serviceOptions)
                                {
                                    <MudSelectItem Value="@service.Name">@service.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="selectedSwaggerTag" Label="Tag" Variant="Variant.Outlined"
                                       FullWidth="true" @bind-Value:after="OnSwaggerTagChanged">
                                @foreach (string tag in swaggerTagOptions)
                                {
                                    <MudSelectItem Value="@tag">@tag</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudAutocomplete T="SwaggerEndpointOption" Value="selectedSwaggerEndpoint"
                                             ValueChanged="OnSwaggerEndpointChanged" SearchFunc="SearchSwaggerEndpoints"
                                             ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<SwaggerEndpointOption>" Label="Endpoint from swagger"
                                             Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="50" />
                        </MudItem>
                    </MudGrid>

                    @if (selectedSwaggerEndpoint is not null)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-3">
                            @selectedSwaggerEndpoint.Tag
                            @if (!string.IsNullOrWhiteSpace(selectedSwaggerEndpoint.Description))
                            {
                                <span> · @selectedSwaggerEndpoint.Description</span>
                            }
                        </MudText>

                        @if (selectedSwaggerEndpoint.Parameters.Count > 0)
                        {
                            <div class="d-flex flex-wrap ga-2 mt-2">
                                @foreach (SwaggerParameterOption parameter in selectedSwaggerEndpoint.Parameters)
                                {
                                    <MudChip T="string" Value="@parameter.Name" Variant="Variant.Outlined" Size="Size.Small">
                                        @parameter.Location: @parameter.Name=@parameter.SampleValue
                                        @if (parameter.Required)
                                        {
                                            <span> *</span>
                                        }
                                    </MudChip>
                                }
                            </div>
                        }
                    }
                </MudPaper>

                <MudGrid Class="mb-3">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="requestName" Label="Request Name" Variant="Variant.Outlined"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="string" @bind-Value="selectedMethod" Label="Method" Variant="Variant.Outlined"
                                   FullWidth="true">
                            @foreach (string method in methodOptions)
                            {
                                <MudSelectItem Value="@method">@method</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField Value="@selectedDomain" Label="Domain" Variant="Variant.Outlined" FullWidth="true"
                                      ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" md="7">
                        <MudTextField @bind-Value="endpoint" Label="Endpoint" Variant="Variant.Outlined"
                                      FullWidth="true" />
                    </MudItem>
                </MudGrid>

                <MudAutocomplete T="Employee" Value="SelectedDriver" ValueChanged="OnDriverChanged"
                                 SearchFunc="SearchDrivers" ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<Employee>"
                                 Label="Driver" Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20"
                                 Class="mb-3" />

                <MudTextField @bind-Value="accessToken" Label="Bearer Token" Variant="Variant.Outlined" FullWidth="true"
                              Lines="3" Class="mb-3" />

                <MudTextField @bind-Value="requestBody" Label="Body (JSON)" Variant="Variant.Outlined" FullWidth="true"
                              Lines="12" AutoGrow="true" Class="mb-4" />

                <div class="d-flex align-center justify-end ga-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="FormatRequestBody" Class="ms-2">
                        Format Body
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ContentCopy"
                               OnClick="CopyCurlAsync" Class="ms-2">
                        cURL
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ShowHistoryAsync" Class="ms-2">
                        History
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Send" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@isSubmitting" OnClick="SendRequestAsync" Class="ms-2">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <MudText>Sending...</MudText>
                        }
                        else
                        {
                            <MudText>Send</MudText>
                        }
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4 response-panel">
                <MudText Typo="Typo.h5" Class="mb-4">Response</MudText>

                <MudGrid Class="mb-3">
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">Status</MudText>
                        <MudText Typo="Typo.subtitle2">@responseStatus</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">Duration</MudText>
                        <MudText Typo="Typo.subtitle2">@responseDuration</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.caption">Content-Type</MudText>
                        <MudText Typo="Typo.subtitle2">@responseContentType</MudText>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Headers</MudText>
                <MudPaper Outlined="true" Class="pa-3 response-block mb-3">
                    <pre>@responseHeaders</pre>
                </MudPaper>

                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.subtitle2">Body</MudText>
                    <div class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="isBeautyView" @bind-Value:after="OnResponseBodyViewChanged"
                                   Color="Color.Primary" Label="Beauty" />
                        <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                       Icon="@Icons.Material.Filled.ContentCopy" Disabled="@(responseBody == "(empty)")"
                                       OnClick="CopyResponseBodyAsync" Class="ms-4" />
                    </div>
                </div>
                <MudPaper Outlined="true" Class="pa-3 response-block">
                    <pre>@responseBody</pre>
                </MudPaper>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .request-panel,
    .response-panel {
        min-height: 80vh;
    }

    .swagger-panel {
        background: rgba(0, 0, 0, 0.02);
    }

    .response-block {
        min-height: 180px;
        max-height: 32vh;
        overflow: auto;
    }

    .response-block pre {
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

@code {
    private const string ApiPrefix = "/api/v1/";
    private readonly List<string> methodOptions = ["GET", "POST", "PUT", "DELETE"];
    private readonly List<ServiceOption> serviceOptions = [];
    private List<Employee> emps = [];
    private List<string> swaggerTagOptions = [AllSwaggerTagsOption];
    private List<SwaggerEndpointOption> swaggerEndpoints = [];

    private const string AllSwaggerTagsOption = "All";
    private Employee? selectedDriver;
    private SwaggerEndpointOption? selectedSwaggerEndpoint;
    private string requestName = string.Empty;
    private string selectedMethod = "POST";
    private string selectedService = string.Empty;
    private string selectedDomain = string.Empty;
    private string selectedSwaggerTag = AllSwaggerTagsOption;
    private string endpoint = ApiPrefix;
    private string requestBody = string.Empty;
    private string accessToken = string.Empty;
    private bool isSubmitting;
    private string swaggerDocumentTitle = string.Empty;
    private string swaggerStatusText = "Swagger file not loaded.";

    private string responseStatus = "-";
    private string responseDuration = "-";
    private string responseContentType = "-";
    private string responseMediaType = string.Empty;
    private string responseHeaders = "(empty)";
    private string rawResponseBody = "(empty)";
    private string responseBody = "(empty)";
    private bool isBeautyView;

    private string resolvedUrl => BuildRequestUrl();

    protected override async Task OnInitializedAsync()
    {
        emps = (await MyEmployeeService.GetAllEmployeesAsync(CancellationToken.None))
            .OrderBy(x => x.Code)
            .ThenBy(x => x.Name)
            .ToList();

        serviceOptions.AddRange([
            new ServiceOption("Fleet", ApiUrlsOptions.Fleet),
            new ServiceOption("Driver", ApiUrlsOptions.Driver),
            new ServiceOption("Cost", ApiUrlsOptions.Cost),
            new ServiceOption("Route", ApiUrlsOptions.Route),
            new ServiceOption("Order", ApiUrlsOptions.Order),
            new ServiceOption("Planning", ApiUrlsOptions.Planning),
            new ServiceOption("Tracking", ApiUrlsOptions.Tracking),
            new ServiceOption("Notification", ApiUrlsOptions.Notification),
            new ServiceOption("Audit", ApiUrlsOptions.Audit),
            new ServiceOption("File", ApiUrlsOptions.File),
            new ServiceOption("Report", ApiUrlsOptions.Report)
        ]);

        selectedService = serviceOptions.FirstOrDefault()?.Name ?? string.Empty;
        selectedDomain = serviceOptions.FirstOrDefault()?.Domain ?? string.Empty;
        await LoadSwaggerForSelectedServiceAsync(showNotifications: false);
    }

    private Employee? SelectedDriver
    {
        get => selectedDriver;
        set
        {
            selectedDriver = value;
            accessToken = value?.BearerToken ?? string.Empty;
        }
    }

    private Task OnDriverChanged(Employee? value)
    {
        SelectedDriver = value;
        return Task.CompletedTask;
    }

    private async Task OnServiceChanged()
    {
        selectedDomain = ResolveSelectedDomain(selectedService);
        await LoadSwaggerForSelectedServiceAsync(showNotifications: true);
    }

    private Task OnSwaggerTagChanged()
    {
        if (selectedSwaggerEndpoint is not null && !IsEndpointVisible(selectedSwaggerEndpoint))
        {
            selectedSwaggerEndpoint = null;
        }

        return Task.CompletedTask;
    }

    private async Task LoadSwaggerForSelectedServiceAsync(bool showNotifications)
    {
        selectedSwaggerEndpoint = null;
        swaggerEndpoints = [];
        swaggerTagOptions = [AllSwaggerTagsOption];
        selectedSwaggerTag = AllSwaggerTagsOption;
        swaggerDocumentTitle = string.Empty;

        SwaggerDocumentInfo? document = await ApiRequestSwaggerService.LoadAsync(selectedService, CancellationToken.None);
        if (document is null)
        {
            swaggerStatusText = $"Templates/Swagger.{selectedService}.json not found.";
            if (showNotifications)
            {
                Snackbar.Add(swaggerStatusText, Severity.Info);
            }

            return;
        }

        swaggerDocumentTitle = document.Title;
        swaggerEndpoints = document.Endpoints.ToList();
        swaggerTagOptions = [AllSwaggerTagsOption, .. document.Tags];
        swaggerStatusText = $"{swaggerDocumentTitle}: {swaggerEndpoints.Count} endpoints.";

        if (showNotifications)
        {
            Snackbar.Add($"Loaded Swagger.{selectedService}.json.", Severity.Success);
        }
    }

    private Task<IEnumerable<SwaggerEndpointOption>> SearchSwaggerEndpoints(string value, CancellationToken cancellationToken)
    {
        IEnumerable<SwaggerEndpointOption> visibleEndpoints = swaggerEndpoints.Where(IsEndpointVisible);
        IEnumerable<SwaggerEndpointOption> results = AutocompleteSearchHelper.SearchByLike(visibleEndpoints, value);
        return Task.FromResult(results.Take(50));
    }

    private Task OnSwaggerEndpointChanged(SwaggerEndpointOption? endpointOption)
    {
        selectedSwaggerEndpoint = endpointOption;
        if (endpointOption is null)
        {
            return Task.CompletedTask;
        }

        selectedMethod = endpointOption.Method;
        endpoint = endpointOption.Path;
        requestBody = endpointOption.SampleRequestBody;
        requestName = endpointOption.DisplayName;
        return Task.CompletedTask;
    }

    private bool IsEndpointVisible(SwaggerEndpointOption endpointOption)
    {
        return selectedSwaggerTag == AllSwaggerTagsOption
            || endpointOption.Tag.Equals(selectedSwaggerTag, StringComparison.OrdinalIgnoreCase);
    }

    private Task<IEnumerable<Employee>> SearchDrivers(string value, CancellationToken cancellationToken)
    {
        IEnumerable<Employee> results = AutocompleteSearchHelper.SearchByLike(emps, value, orderByRelevance: false);
        return Task.FromResult(results);
    }

    private async Task CopyCurlAsync()
    {
        string requestUrl = BuildRequestUrl();
        if (string.IsNullOrWhiteSpace(requestUrl))
        {
            Snackbar.Add("Cannot build URL. Please check service and endpoint.", Severity.Warning);
            return;
        }

        System.Text.StringBuilder sb = new();
        sb.Append($"curl -X {selectedMethod}");
        sb.Append($" \"{requestUrl}\"");

        string normalizedToken = NormalizeToken(accessToken);
        if (!string.IsNullOrWhiteSpace(normalizedToken))
        {
            sb.Append($" -H \"Authorization: Bearer {normalizedToken}\"");
        }

        DepartmentDto? department = CacheService.GetSessionDepartment(BrowserContext.BrowserId);
        if (department is not null)
        {
            sb.Append($" -H \"Departmentid: {department.Id}\"");
            sb.Append($" -H \"Companyid: {department.CompanyId}\"");
        }

        if (ShouldIncludeBody(selectedMethod) && !string.IsNullOrWhiteSpace(requestBody))
        {
            sb.Append(" -H \"Content-Type: application/json\"");
            string escapedBody = requestBody.Replace("\\", "\\\\").Replace("\"", "\\\"");
            sb.Append($" -d \"{escapedBody}\"");
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            Snackbar.Add("cURL command copied.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot copy cURL: {ex.Message}", Severity.Error);
        }
    }

    private void FormatRequestBody()
    {
        if (string.IsNullOrWhiteSpace(requestBody))
        {
            Snackbar.Add("Body is empty.", Severity.Warning);
            return;
        }

        try
        {
            requestBody = ApiRequestBodyFormatterService.NormalizeAndFormatJson(requestBody);
            Snackbar.Add("Request body formatted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot format body: {ex.Message}", Severity.Warning);
        }
    }

    private async Task SendRequestAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDomain))
        {
            Snackbar.Add("Please select a service to determine the domain.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(endpoint))
        {
            Snackbar.Add("Please enter an endpoint.", Severity.Warning);
            return;
        }

        string requestUrl = BuildRequestUrl();
        if (string.IsNullOrWhiteSpace(requestUrl))
        {
            Snackbar.Add("Invalid URL.", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            using HttpClient client = HttpClientFactory.CreateClient("ApiRequest");
            using HttpRequestMessage request = new(new HttpMethod(selectedMethod), requestUrl);

            string normalizedToken = NormalizeToken(accessToken);
            if (!string.IsNullOrWhiteSpace(normalizedToken))
            {
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", normalizedToken);
            }

            if (ShouldIncludeBody(selectedMethod) && !string.IsNullOrWhiteSpace(requestBody))
            {
                request.Content = new StringContent(requestBody, Encoding.UTF8, "application/json");
            }

            Stopwatch stopwatch = Stopwatch.StartNew();
            using HttpResponseMessage response = await client.SendAsync(request);
            stopwatch.Stop();

            string content = await response.Content.ReadAsStringAsync();
            responseStatus = $"{(int)response.StatusCode} {response.ReasonPhrase}";
            responseDuration = $"{stopwatch.ElapsedMilliseconds} ms";
            responseContentType = response.Content.Headers.ContentType?.ToString() ?? "-";
            responseMediaType = response.Content.Headers.ContentType?.MediaType ?? string.Empty;

            List<string> headerLines = [];
            headerLines.AddRange(response.Headers.SelectMany(h => h.Value.Select(v => $"{h.Key}: {v}")));
            headerLines.AddRange(response.Content.Headers.SelectMany(h => h.Value.Select(v => $"{h.Key}: {v}")));
            responseHeaders = headerLines.Count == 0 ? "(empty)" : string.Join(Environment.NewLine, headerLines);
            rawResponseBody = string.IsNullOrWhiteSpace(content) ? "(empty)" : content;
            UpdateDisplayedResponseBody();
            await SaveRequestHistoryAsync();

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Request sent successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Request failed: {responseStatus}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            responseStatus = "Exception";
            responseDuration = "-";
            responseContentType = "-";
            responseMediaType = string.Empty;
            responseHeaders = "(empty)";
            rawResponseBody = ex.ToString();
            UpdateDisplayedResponseBody();
            Snackbar.Add($"Request error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void UpdateDisplayedResponseBody()
    {
        responseBody = isBeautyView
            ? FormatResponseBody(rawResponseBody, responseMediaType)
            : rawResponseBody;
    }

    private Task OnResponseBodyViewChanged()
    {
        UpdateDisplayedResponseBody();
        return Task.CompletedTask;
    }

    private async Task CopyResponseBodyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", responseBody);
            Snackbar.Add("Response body copied.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot copy response body: {ex.Message}", Severity.Error);
        }
    }

    private string BuildRequestUrl()
    {
        string endpointValue = endpoint.Trim();
        if (string.IsNullOrWhiteSpace(endpointValue))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(endpointValue, UriKind.Absolute, out Uri? absoluteUri))
        {
            return absoluteUri.ToString();
        }

        string domain = selectedDomain.Trim().TrimEnd('/');
        string normalizedEndpoint = NormalizeRelativeEndpoint(endpointValue);
        return string.IsNullOrWhiteSpace(domain) ? string.Empty : $"{domain}{normalizedEndpoint}";
    }

    private async Task ShowHistoryAsync()
    {
        List<RequestHistory> histories = await ApiRequestHistoryService.GetLatestAsync(100, CancellationToken.None);
        if (histories.Count == 0)
        {
            Snackbar.Add("No request history found.", Severity.Info);
            return;
        }

        DialogParameters<RequestHistoryDialog> parameters = new()
        {
            { x => x.Histories, histories }
        };

        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<RequestHistoryDialog>("Request History", parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: RequestHistory selectedHistory })
        {
            ApplyHistory(selectedHistory);
            Snackbar.Add("Request history loaded.", Severity.Success);
        }
    }

    private void ApplyHistory(RequestHistory history)
    {
        requestName = history.Name;
        selectedMethod = history.Method;
        selectedService = history.Service;
        selectedDomain = ResolveSelectedDomain(selectedService);
        endpoint = history.Endpoint;
        requestBody = history.JsonBody;
    }

    private async Task SaveRequestHistoryAsync()
    {
        try
        {
            string historyName = string.IsNullOrWhiteSpace(requestName)
                ? $"{selectedMethod} {selectedService} {endpoint}".Trim()
                : requestName.Trim();

            await ApiRequestHistoryService.SaveRequestAsync(
                historyName,
                selectedMethod,
                selectedService,
                endpoint,
                requestBody,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot save request history: {ex.Message}", Severity.Warning);
        }
    }

    private string ResolveSelectedDomain(string serviceName)
    {
        return serviceOptions.FirstOrDefault(x => x.Name == serviceName)?.Domain ?? string.Empty;
    }

    private static string NormalizeRelativeEndpoint(string endpointValue)
    {
        string normalized = endpointValue.Trim();
        if (!normalized.StartsWith('/'))
        {
            normalized = $"/{normalized}";
        }

        if (normalized.StartsWith(ApiPrefix, StringComparison.OrdinalIgnoreCase))
        {
            return normalized;
        }

        return normalized == "/"
            ? ApiPrefix
            : $"{ApiPrefix}{normalized}";
    }

    private static bool ShouldIncludeBody(string method)
    {
        return method is "POST" or "PUT" or "PATCH" or "DELETE";
    }

    private static string NormalizeToken(string token)
    {
        string trimmed = token.Trim();
        if (trimmed.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed[7..].Trim();
        }

        return trimmed;
    }

    private static string FormatResponseBody(string content, string? mediaType)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return "(empty)";
        }

        string trimmed = content.Trim();
        bool looksLikeJson = trimmed.StartsWith('{') || trimmed.StartsWith('[');
        bool isJsonContentType = mediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true;

        if (!looksLikeJson && !isJsonContentType)
        {
            return content;
        }

        try
        {
            using JsonDocument document = JsonDocument.Parse(content);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch
        {
            return content;
        }
    }

    private sealed record ServiceOption(string Name, string Domain);
}