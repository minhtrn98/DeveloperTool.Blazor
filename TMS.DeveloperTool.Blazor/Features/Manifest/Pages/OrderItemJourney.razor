@page "/manifest/order-item-journey"

@using TMS.DeveloperTool.Blazor.Infrastructure.Configuration
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Dtos
@inject ManifestRepository ManifestRepository
@inject FeUrlsOptions FeUrlsOptions
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<AppPageTitle MenuName="Hành trình vận đơn" />

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-4">Hành trình vận đơn</MudText>

        <div class="d-flex align-center ga-3 flex-wrap">
            <MudTextField @bind-Value="orderItemId" Label="Mã kiện hàng (Order Item Id)" Placeholder="Ví dụ: TOK2602846"
                          Variant="Variant.Outlined" Clearable="true" Class="flex-grow-1"
                          Immediate="true" OnKeyDown="OnKeyDown" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       OnClick="@(() => SearchAsync())" Disabled="@(isLoading || string.IsNullOrWhiteSpace(orderItemId))">
                Tra cứu
            </MudButton>
        </div>
    </MudPaper>

    @if (orderSummary is not null)
    {
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <div class="d-flex flex-column ga-1">
                <MudText Typo="Typo.body2"><b>Mã đơn:</b> <FeSearchLink SearchTerm="@orderSummary.OrderId" Path="du-bao-hang-hoa/theo-hanh-trinh-van-don" ExtraQuery="@BuildOrderTrackingExtraQuery(orderSummary.CreatedAt)" /></MudText>
                <MudText Typo="Typo.body2"><b>Trạng thái:</b> @DisplayText(orderSummary.CurrentStatusName)</MudText>
                <MudText Typo="Typo.body2"><b>Dịch vụ:</b> @DisplayText(orderSummary.ServiceType)</MudText>
                <MudText Typo="Typo.body2"><b>Dịch vụ gia tăng:</b> @DisplayText(orderSummary.ExtraService)</MudText>
                <MudText Typo="Typo.body2"><b>Trọng lượng:</b> @(orderSummary.Weight.HasValue ? $"{orderSummary.Weight.Value:F3} kg" : "—")</MudText>
                <MudText Typo="Typo.body2"><b>Điều tin:</b> <FeSearchLink SearchTerm="@orderSummary.PickupTaskId" Path="dieu-phoi/dieu-tin" ExtraQuery="@BuildDispatchExtraQuery(orderSummary.CreatedAt)" SearchParamName="dispatchSearchTerm" /></MudText>
                <MudText Typo="Typo.body2"><b>Ngày tạo:</b> @FormatDate(orderSummary.CreatedAt)</MudText>
            </div>
        </MudPaper>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!hasSearched)
    {
        <MudAlert Severity="Severity.Info">Nhập mã kiện hàng để xem hành trình.</MudAlert>
    }
    else if (rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Không tìm thấy hành trình cho kiện hàng này.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-2">
            <div style="overflow-x: auto;">
                <MudTable Items="@rows" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>Thời gian</MudTh>
                        <MudTh>Nghiệp vụ</MudTh>
                        <MudTh>Hành động</MudTh>
                        <MudTh>Chuyến thư / Sổ phát</MudTh>
                        <MudTh>Điều tin</MudTh>
                        <MudTh>Điều tin lấy</MudTh>
                        <MudTh>Kế hoạch</MudTh>
                        <MudTh>Lộ trình</MudTh>
                        <MudTh>Tài xế</MudTh>
                        <MudTh>Biển số</MudTh>
                        <MudTh>Bàn giao</MudTh>
                        <MudTh>Điểm dừng</MudTh>
                        <MudTh>Lý do sai vị trí</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Thời gian">@FormatDate(context.ActionAt)</MudTd>
                        <MudTd DataLabel="Nghiệp vụ">@context.Operation</MudTd>
                        <MudTd DataLabel="Hành động">@context.Action</MudTd>
                        <MudTd DataLabel="Chuyến thư / Sổ phát">@DisplayText(context.ManifestCode ?? context.ExternalId)</MudTd>
                        <MudTd DataLabel="Điều tin">@DisplayText(context.PickupTaskId)</MudTd>
                        <MudTd DataLabel="Điều tin lấy">@DisplayText(context.ConfirmedPickupTaskId)</MudTd>
                        <MudTd DataLabel="Kế hoạch"><FeSearchLink SearchTerm="@context.PlanCode" Path="ke-hoach-hoat-dong/ke-hoach-van-chuyen" /></MudTd>
                        <MudTd DataLabel="Lộ trình"><FeSearchLink SearchTerm="@context.AssignmentCode" Path="quan-ly-lo-trinh/lo-trinh-xe-tai" ExtraQuery="page=1" /></MudTd>
                        <MudTd DataLabel="Tài xế"><FeSearchLink SearchTerm="@context.DriverCode" Path="quan-ly-nhan-vien/nhan-vien" /></MudTd>
                        <MudTd DataLabel="Biển số"><FeSearchLink SearchTerm="@context.VehicleLicensePlate" Path="quan-ly-phuong-tien/danh-sach" ExtraQuery="page=1" /></MudTd>
                        <MudTd DataLabel="Bàn giao">
                            @if (context.Operation == "Đi nhận" && !string.IsNullOrWhiteSpace(context.HandoverCode)
                                    && !string.IsNullOrWhiteSpace(context.ConfirmedPickupTaskId) && !string.IsNullOrWhiteSpace(FeUrlsOptions.BaseUrl))
                            {
                                <MudLink Href="@GetPickupHandoverUrl(context.ConfirmedPickupTaskId, context.HandoverCode)" Target="_blank">@context.HandoverCode</MudLink>
                            }
                            else
                            {
                                @DisplayText(context.HandoverCode)
                            }
                            @if (!string.IsNullOrWhiteSpace(context.HandoverId))
                            {
                                <div class="d-flex" style="gap: 10px">
                                    <MudLink Typo="Typo.caption" Style="cursor:pointer" OnClick="@(() => OpenHandoverItemsAsync(context))">Kiện liên quan</MudLink>
                                    <MudLink Typo="Typo.caption" Style="cursor:pointer" OnClick="@(() => OpenHandoverEvidencesAsync(context))">Bằng chứng</MudLink>
                                    <MudLink Typo="Typo.caption" Style="cursor:pointer" OnClick="@(() => OpenHandoverParticipantsAsync(context))">NV lên/xuống hàng</MudLink>
                                </div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Điểm dừng">@FormatStop(context.StopCode, context.StopName)</MudTd>
                        <MudTd DataLabel="Lý do thất lạc">@DisplayText(context.MisplacedReasonName)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4">Không tìm thấy hành trình cho kiện hàng này.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "orderItemId")]
    [Parameter]
    public string? QueryOrderItemId { get; set; }

    private string orderItemId = string.Empty;
    private List<OrderItemJourneyDto> rows = [];
    private OrderSummaryDto? orderSummary;
    private bool isLoading;
    private bool hasSearched;

    protected override async Task OnParametersSetAsync()
    {
        if (!hasSearched && !string.IsNullOrWhiteSpace(QueryOrderItemId))
        {
            orderItemId = QueryOrderItemId;
            await SearchAsync(updateUrl: false);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync(bool updateUrl = true)
    {
        string trimmed = orderItemId.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            Snackbar.Add("Vui lòng nhập mã kiện hàng.", Severity.Warning);
            return;
        }

        isLoading = true;
        try
        {
            rows = await ManifestRepository.GetOrderItemJourneyAsync(trimmed, CancellationToken.None);
            orderSummary = await ManifestRepository.GetOrderSummaryByOrderItemIdAsync(trimmed, CancellationToken.None);
            hasSearched = true;

            if (updateUrl)
            {
                NavigationManager.NavigateTo($"/manifest/order-item-journey?orderItemId={Uri.EscapeDataString(trimmed)}", replace: true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể tải dữ liệu: {ex.Message}", Severity.Error);
            rows = [];
            orderSummary = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenHandoverItemsAsync(OrderItemJourneyDto row)
    {
        if (string.IsNullOrWhiteSpace(row.HandoverId)) return;

        DialogParameters<HandoverItemsDialog> parameters = new()
        {
            { d => d.HandoverId, row.HandoverId },
            { d => d.HandoverCode, row.HandoverCode ?? string.Empty },
            { d => d.Operation, row.Operation },
            { d => d.Action, row.Action },
        };
        DialogOptions options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<HandoverItemsDialog>(row.HandoverCode ?? "Kiện hàng bàn giao", parameters, options);
    }

    private async Task OpenHandoverEvidencesAsync(OrderItemJourneyDto row)
    {
        if (string.IsNullOrWhiteSpace(row.HandoverId)) return;

        DialogParameters<HandoverEvidencesDialog> parameters = new()
        {
            { d => d.HandoverId, row.HandoverId },
            { d => d.HandoverCode, row.HandoverCode ?? string.Empty },
        };
        DialogOptions options = new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<HandoverEvidencesDialog>(row.HandoverCode ?? "Bằng chứng bàn giao", parameters, options);
    }

    private async Task OpenHandoverParticipantsAsync(OrderItemJourneyDto row)
    {
        if (string.IsNullOrWhiteSpace(row.HandoverId)) return;

        DialogParameters<HandoverParticipantsDialog> parameters = new()
        {
            { d => d.HandoverId, row.HandoverId },
            { d => d.HandoverCode, row.HandoverCode ?? string.Empty },
        };
        DialogOptions options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<HandoverParticipantsDialog>(row.HandoverCode ?? "Nhân viên bàn giao", parameters, options);
    }

    private string GetPickupHandoverUrl(string confirmedPickupTaskId, string handoverCode)
        => $"{FeUrlsOptions.BaseUrl.TrimEnd('/')}/dieu-phoi/dieu-tin/theo-tin/{Uri.EscapeDataString(confirmedPickupTaskId)}/ban-giao/{Uri.EscapeDataString(handoverCode)}";

    private static (string From, string To) GetCreatedDateRangeUtc(DateTime createdAt)
    {
        DateTime fromVn = createdAt.ToLocalTime().Date;
        DateTime toVn = fromVn.AddDays(1).AddTicks(-1);
        string from = Uri.EscapeDataString(fromVn.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ"));
        string to = Uri.EscapeDataString(toVn.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ"));
        return (from, to);
    }

    private static string BuildOrderTrackingExtraQuery(DateTime createdAt)
    {
        (string from, string to) = GetCreatedDateRangeUtc(createdAt);
        return $"statusIds=&fromAcceptedTime={from}&toAcceptedTime={to}";
    }

    private static string BuildDispatchExtraQuery(DateTime createdAt)
    {
        (string from, string to) = GetCreatedDateRangeUtc(createdAt);
        return $"page=1&tab=by-dispatch&f_fromCreatedDate={from}&f_toCreatedDate={to}";
    }

    private static string FormatDate(DateTimeOffset? value)
        => value is null ? "—" : value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");

    private static string FormatStop(string? code, string? name)
    {
        bool hasCode = !string.IsNullOrWhiteSpace(code);
        bool hasName = !string.IsNullOrWhiteSpace(name);
        if (!hasCode && !hasName) return "—";
        if (!hasCode) return name!;
        if (!hasName) return code!;
        return $"{code} - {name}";
    }

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
