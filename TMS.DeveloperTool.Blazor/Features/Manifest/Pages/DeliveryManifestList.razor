@page "/manifest/list"

@using TMS.DeveloperTool.Blazor.Features.Manifest.Services
@using TMS.DeveloperTool.Blazor.Features.Manifest.Contracts
@using TMS.DeveloperTool.Blazor.Domain.Enums
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Interfaces
@inject DeliveryManifestService DeliveryManifestService
@inject ManifestOrderService ManifestOrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<AppPageTitle MenuName="Danh sách sổ phát" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h4" Class="mb-4">Danh sách sổ phát</MudText>

        <MudGrid Class="mb-4">
            <MudItem xs="12" md="2">
                <MudDatePicker @bind-Date="fromDate"
                               Label="Từ ngày"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker @bind-Date="toDate"
                               Label="Đến ngày"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudAutocomplete T="Employee"
                                 @bind-Value="selectedDriver"
                                 SearchFunc="SearchDrivers"
                                 Label="Tài xế"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MaxItems="20"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<Employee>" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudAutocomplete T="StatusOption"
                                 @bind-Value="selectedStatus"
                                 SearchFunc="SearchStatuses"
                                 Label="Trạng thái"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MaxItems="10"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<StatusOption>" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudAutocomplete T="TypeOption"
                                 @bind-Value="selectedType"
                                 SearchFunc="SearchTypes"
                                 Label="Loại sổ"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 MaxItems="10"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<TypeOption>" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchAsync"
                           FullWidth="true">
                    Tìm kiếm
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudTable @ref="tableRef"
                  T="ManifestListItemDto"
                  ServerData="LoadServerData"
                  Hover="true"
                  Dense="true"
                  Breakpoint="Breakpoint.Sm"
                  RowClass="cursor-pointer"
                  OnRowClick="OnRowClickedAsync">
            <HeaderContent>
                <MudTh>Mã sổ phát</MudTh>
                <MudTh>Loại</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Đơn</MudTh>
                <MudTh>Kiện trong sổ phát</MudTh>
                <MudTh>Kiện đã lên hàng</MudTh>
                <MudTh>Kiện đã phát</MudTh>
                <MudTh>COD (₫)</MudTh>
                <MudTh>Ngày tạo</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Mã sổ phát"><b>@context.Code</b></MudTd>
                <MudTd DataLabel="Loại">
                    <MudChip T="string"
                             Color="@(context.ManifestType == DeliveryManifestType.Cod ? Color.Warning : Color.Info)"
                             Size="Size.Small"
                             Ripple="false">
                        @GetTypeLabel(context.ManifestType)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Trạng thái">
                    <MudChip T="string"
                             Color="@GetStatusColor(context.Status)"
                             Size="Size.Small"
                             Ripple="false">
                        @GetStatusLabel(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Đơn">@context.TotalOrders</MudTd>
                <MudTd DataLabel="Kiện trong sổ phát">@context.TotalItems</MudTd>
                <MudTd DataLabel="Đã đã lên hàng">@context.LoadedItems</MudTd>
                <MudTd DataLabel="Đã đã phát">@context.DeliveredItems</MudTd>
                <MudTd DataLabel="COD (₫)">@(context.TotalCodAmount.HasValue ? context.TotalCodAmount.Value.ToString("N0") : "-")</MudTd>
                <MudTd DataLabel="Ngày tạo">@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">Không có sổ phát nào.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText Class="pa-4">Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private MudTable<ManifestListItemDto>? tableRef;
    private DateTime? fromDate;
    private DateTime? toDate;
    private StatusOption? selectedStatus;
    private TypeOption? selectedType;
    private Employee? selectedDriver;
    private List<Employee> allEmployees = [];

    private static readonly StatusOption[] AllStatuses =
    [
        new(DeliveryManifestStatus.Initialized, "Khởi tạo"),
        new(DeliveryManifestStatus.Active, "Đang phát"),
        new(DeliveryManifestStatus.PartiallyDelivered, "Chưa phát xong"),
        new(DeliveryManifestStatus.Completed, "Đã phát"),
        new(DeliveryManifestStatus.Cancelled, "Hủy"),
    ];

    private static readonly TypeOption[] AllTypes =
    [
        new(DeliveryManifestType.Express, "Chuyển phát nhanh"),
        new(DeliveryManifestType.Cod, "COD"),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allEmployees = await ManifestOrderService.GetEmployeesAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể tải danh sách tài xế: {ex.Message}", Severity.Error);
        }
    }

    private async Task SearchAsync() => await (tableRef?.ReloadServerData() ?? Task.CompletedTask);

    private async Task OnRowClickedAsync(TableRowClickEventArgs<ManifestListItemDto> args)
    {
        if (args.Item is null) return;
        DialogParameters<ManifestOrdersDialog> parameters = new()
        {
            { d => d.ManifestId, args.Item.DeliveryManifestId },
            { d => d.ManifestCode, args.Item.Code },
            { d => d.Authorization, Authorization },
        };
        DialogOptions options = new() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<ManifestOrdersDialog>(args.Item.Code, parameters, options);
    }

    private Task<IEnumerable<Employee>> SearchDrivers(string term, CancellationToken _)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(allEmployees, term));

    private string Authorization => selectedDriver is null ? string.Empty : $"Bearer {selectedDriver.BearerToken}";

    private async Task<TableData<ManifestListItemDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        if (selectedDriver is null)
            return new TableData<ManifestListItemDto> { TotalItems = 0, Items = [] };

        try
        {
            SearchManifestRequest request = new()
            {
                Page = state.Page + 1,
                PageSize = state.PageSize,
                FromDate = fromDate,
                ToDate = toDate,
                Status = selectedStatus?.Value,
                ManifestType = selectedType?.Value,
                AssignedDriverId = selectedDriver?.EmployeeId,
            };

            PagedResult<ManifestListItemDto> result = await DeliveryManifestService.SearchAsync(request, Authorization, ct);
            return new TableData<ManifestListItemDto>
            {
                TotalItems = result.TotalCount,
                Items = result.Items,
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể tải dữ liệu: {ex.Message}", Severity.Error);
            return new TableData<ManifestListItemDto> { TotalItems = 0, Items = [] };
        }
    }

    private Task<IEnumerable<StatusOption>> SearchStatuses(string term, CancellationToken _)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(AllStatuses, term));

    private Task<IEnumerable<TypeOption>> SearchTypes(string term, CancellationToken _)
        => Task.FromResult(AutocompleteSearchHelper.SearchByLike(AllTypes, term));

    private static Color GetStatusColor(DeliveryManifestStatus status) => status switch
    {
        DeliveryManifestStatus.Initialized => Color.Default,
        DeliveryManifestStatus.Active => Color.Primary,
        DeliveryManifestStatus.PartiallyDelivered => Color.Warning,
        DeliveryManifestStatus.Completed => Color.Success,
        DeliveryManifestStatus.Cancelled => Color.Error,
        _ => Color.Default,
    };

    private static string GetStatusLabel(DeliveryManifestStatus status) => status switch
    {
        DeliveryManifestStatus.Initialized => "Khởi tạo",
        DeliveryManifestStatus.Active => "Đang phát",
        DeliveryManifestStatus.PartiallyDelivered => "Chưa phát xong",
        DeliveryManifestStatus.Completed => "Đã phát",
        DeliveryManifestStatus.Cancelled => "Hủy",
        _ => $"#{(int)status}",
    };

    private static string GetTypeLabel(DeliveryManifestType type) => type switch
    {
        DeliveryManifestType.Express => "Chuyển phát nhanh",
        DeliveryManifestType.Cod => "COD",
        _ => $"#{(int)type}",
    };

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed record StatusOption(DeliveryManifestStatus Value, string Label) : IDisplaySearchItem
    {
        public string DisplayString => Label;
        public bool Like(string s) => Label.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private sealed record TypeOption(DeliveryManifestType Value, string Label) : IDisplaySearchItem
    {
        public string DisplayString => Label;
        public bool Like(string s) => Label.Contains(s, StringComparison.OrdinalIgnoreCase);
    }
}
