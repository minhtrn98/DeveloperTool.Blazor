@page "/pairing"
@using System.Net.Http.Headers
@using TMS.DeveloperTool.Blazor.Domain.Enums
@using TMS.DeveloperTool.Blazor.Features.Pairing.Models
@using TMS.DeveloperTool.Blazor.Features.Routing.Models
@using TMS.DeveloperTool.Blazor.Services
@inject FleetRepository FleetRepository
@inject RouteRepository RouteRepository
@inject PlanningRepository PlanningRepository
@inject MyDriverService MyDriverService
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<PageTitle>Ghép xe</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">Ghép xe</MudText>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <MudForm>
                <MudSelect T="string" @bind-Value="apiHost" Label="Host API" Variant="Variant.Outlined" FullWidth="true"
                           Adornment="Adornment.End" AdornmentText="@GetApiPath()" Class="mb-3">
                    @foreach (string host in apiHostOptions)
                    {
                        <MudSelectItem Value="@host">@host</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="accessToken" Label="Bearer Token" Variant="Variant.Outlined" FullWidth="true" Lines="4"
                              Class="mb-3" />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="companyId" Label="CompanyId" Variant="Variant.Outlined" FullWidth="true"
                                      Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="departmentId" Label="DepartmentId" Variant="Variant.Outlined"
                                      FullWidth="true" Class="mb-3" />
                    </MudItem>
                </MudGrid>

                <MudAutocomplete T="Driver" Value="SelectedDriver" ValueChanged="OnDriverChanged"
                                 SearchFunc="SearchDrivers" ToStringFunc="GetDriverLabel" Label="Tài xế"
                                 Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20" Class="mb-3" />

                <MudAutocomplete T="DropdownItem<Guid>" Value="SelectedVehicleOption" ValueChanged="OnVehicleChanged"
                                 SearchFunc="SearchVehicleOptions" ToStringFunc="GetVehicleDropdownLabel" Label="Xe"
                                 Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20" Class="mb-3" />

                <MudSelect T="Guid" @bind-Value="pairingReasonTypeId" Label="Lý do ghép xe" Variant="Variant.Outlined"
                           FullWidth="true" Class="mb-3">
                    @foreach (var item in pairingReasonTypes)
                    {
                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="ActionType" @bind-Value="actionType" Label="Hành động" Variant="Variant.Outlined"
                                   FullWidth="true" Class="mb-3">
                            @foreach (var item in actionTypes)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="double" @bind-Value="odometer" Label="Odometer" Variant="Variant.Outlined"
                                         FullWidth="true" Class="mb-3" />
                    </MudItem>
                </MudGrid>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="AssignmentPlanType" @bind-Value="planningType" @bind-Value:after="OnPlanningTypeChanged"
                                   Label="Loại kế hoạch" Variant="Variant.Outlined"
                                   FullWidth="true" Class="mb-3">
                            @foreach (var item in planningTypes)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="DropdownItem<Guid>" @bind-Value="SelectedPlanningOption"
                                         SearchFunc="SearchPlanningOptions" ToStringFunc="GetDropdownLabel" Label="Kế hoạch"
                                         Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20" Class="mb-3" />
                    </MudItem>
                </MudGrid>

                <MudAutocomplete T="PostOffice" @bind-Value="SelectedPostOffice" SearchFunc="SearchPostOffices"
                                 ToStringFunc="GetPostOfficeLabel" Label="Bưu cục" Variant="Variant.Outlined" FullWidth="true"
                                 Clearable="true" MaxItems="20" Class="mb-3" />

                <MudSwitch @bind-Value="autoCreateMaintenancePlan" Color="Color.Primary"
                           Label="Tự động tạo kế hoạch bảo trì" Class="mb-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSubmitting" OnClick="SubmitAsync">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <MudText>Đang gửi...</MudText>
                    }
                    else
                    {
                        <MudText>Gửi yêu cầu</MudText>
                    }
                </MudButton>
            </MudForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private const string PairingApiPath = "/api/v1/assignments/pairing";
    private const string UnpairingApiPath = "/api/v1/assignments/unpairing";
    private const string UnexpectedApiPath = "/api/v1/assignments/unexpected";
    private static readonly List<string> apiHostOptions =
    [
        "http://localhost:10000",
        "http://247tech.vn:25020"
    ];

    private string apiHost = apiHostOptions[0];
    private string accessToken = string.Empty;
    private string companyId = "01000000-7000-5000-0000-000000000001";
    private string departmentId = "ed4e5a8e-6f02-4d8f-9d1d-2fdca4d0981c";

    private Guid vehicleId;
    private Guid pairingReasonTypeId;
    private ActionType actionType;
    private AssignmentPlanType planningType;
    private Guid planningId;
    private double odometer = 0;
    private bool autoCreateMaintenancePlan;

    private List<DropdownItem<Guid>> vehicleOptions = [];
    private List<DropdownItem<Guid>> pairingReasonTypes = [];
    private List<DropdownItem<ActionType>> actionTypes = [];
    private List<DropdownItem<AssignmentPlanType>> planningTypes = [];
    private List<DropdownItem<Guid>> planningOptions = [];
    private List<PostOffice> postOffices = [];
    private List<Driver> drivers = [];

    private DropdownItem<Guid>? selectedVehicleOption;
    private DropdownItem<Guid>? selectedPlanningOption;
    private PostOffice? selectedPostOffice;
    private Driver? selectedDriver;
    private string address = string.Empty;
    private string postOfficeCode = string.Empty;

    private bool isLoading = true;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        isLoading = true;
        try
        {
            CancellationToken cancellationToken = CancellationToken.None;

            Dictionary<Guid, string> vehicleMap = await FleetRepository.GetAllVehiclePlateAsync(cancellationToken);
            vehicleOptions = vehicleMap
                .OrderBy(kvp => kvp.Value)
                .Select(kvp => new DropdownItem<Guid>(kvp.Key, kvp.Value, kvp.Value))
                .ToList();

            pairingReasonTypes = (await FleetRepository.GetPairingReasonTypes(cancellationToken)).ToList();
            actionTypes = FleetRepository.GetActionTypes().ToList();
            planningTypes = FleetRepository.GetAssignmentPlanTypes().ToList();
            postOffices = (await RouteRepository.GetPostOfficesAsync(cancellationToken))
                .OrderBy(x => x.PostOfficeCode)
                .ToList();
            drivers = (await MyDriverService.GetAllDriversAsync(cancellationToken))
                .OrderBy(x => x.Code)
                .ThenBy(x => x.Name)
                .ToList();

            SelectedVehicleOption = null;
            pairingReasonTypeId = pairingReasonTypes.FirstOrDefault()?.Id ?? Guid.Empty;
            actionType = ActionType.Pairing;
            planningType = AssignmentPlanType.DailyPlan;
            SelectedPlanningOption = null;
            SelectedPostOffice = null;
            SelectedDriver = null;
            await LoadPlanningOptionsAsync(cancellationToken);
        }
        finally
        {
            isLoading = false;
        }
    }

    private DropdownItem<Guid>? SelectedVehicleOption
    {
        get => selectedVehicleOption;
        set
        {
            selectedVehicleOption = value;
            vehicleId = value?.Id ?? Guid.Empty;
        }
    }

    private async Task OnVehicleChanged(DropdownItem<Guid>? value)
    {
        SelectedVehicleOption = value;

        if (vehicleId == Guid.Empty)
        {
            odometer = 0;
            return;
        }

        try
        {
            LatestAssignmentResponse? latestAssignment = await FleetRepository.GetLatestAssignmentAsync(vehicleId);

            if (latestAssignment?.Odometer is not null)
            {
                odometer = (double)latestAssignment.Odometer.Value;
            }
            else
            {
                odometer = await FleetRepository.GetVehicleOdometerAsync(vehicleId);
            }

            if (latestAssignment?.PlanningType is not null)
            {
                planningType = latestAssignment.PlanningType.Value;
            }

            await LoadPlanningOptionsAsync(CancellationToken.None);

            if (latestAssignment?.PlanningId is not null)
            {
                SelectedPlanningOption = planningOptions.FirstOrDefault(plan => plan.Id == latestAssignment.PlanningId.Value);
            }

            if (!string.IsNullOrWhiteSpace(latestAssignment?.Address))
            {
                string startOfficeCode = latestAssignment.Address[..3];
                SelectedPostOffice = postOffices.FirstOrDefault(postOffice =>
                    postOffice.PostOfficeCode == startOfficeCode);
            }

            if (!string.IsNullOrWhiteSpace(latestAssignment?.Address))
            {
                address = latestAssignment.Address;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi xảy ra: {ex.Message}", Severity.Warning);
        }
    }

    private DropdownItem<Guid>? SelectedPlanningOption
    {
        get => selectedPlanningOption;
        set
        {
            selectedPlanningOption = value;
            planningId = value?.Id ?? Guid.Empty;
        }
    }

    private PostOffice? SelectedPostOffice
    {
        get => selectedPostOffice;
        set
        {
            selectedPostOffice = value;
            postOfficeCode = value?.PostOfficeCode ?? string.Empty;
            address = value == null ? string.Empty : $"{value.PostOfficeCode} - {value.PostOfficeName}";
        }
    }

    private Driver? SelectedDriver
    {
        get => selectedDriver;
        set
        {
            selectedDriver = value;
            accessToken = value?.BearerToken ?? string.Empty;
        }
    }

    private string GetPostOfficeLabel(PostOffice? postOffice)
    {
        if (postOffice == null)
        {
            return string.Empty;
        }

        return $"{postOffice.PostOfficeCode} - {postOffice.PostOfficeName}";
    }

    private string GetDropdownLabel(DropdownItem<Guid>? item)
    {
        return item == null ? string.Empty : $"{item.Code} - {item.Name}";
    }

    private string GetVehicleDropdownLabel(DropdownItem<Guid>? item)
    {
        return item == null ? string.Empty : item.Code;
    }

    private string GetDriverLabel(Driver? driver)
    {
        return driver == null ? string.Empty : $"{driver.Code} - {driver.Name}";
    }

    private Task<IEnumerable<DropdownItem<Guid>>> SearchVehicleOptions(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<DropdownItem<Guid>>>(vehicleOptions);
        }

        IEnumerable<DropdownItem<Guid>> results = vehicleOptions.OrderByDescending(item =>
            item.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
            || item.Code.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    private Task<IEnumerable<DropdownItem<Guid>>> SearchPlanningOptions(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<DropdownItem<Guid>>>(planningOptions);
        }

        IEnumerable<DropdownItem<Guid>> results = planningOptions.OrderByDescending(item =>
            item.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
            || item.Code.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    private async Task OnPlanningTypeChanged()
    {
        await LoadPlanningOptionsAsync(CancellationToken.None);
    }

    private async Task LoadPlanningOptionsAsync(CancellationToken cancellationToken)
    {
        planningOptions = [];
        SelectedPlanningOption = null;

        switch (planningType)
        {
            case AssignmentPlanType.DailyPlan:
                planningOptions = (await PlanningRepository.GetDailyPlans(cancellationToken)).ToList();
                break;
            case AssignmentPlanType.Inspection when vehicleId != Guid.Empty:
                planningOptions = (await FleetRepository.GetInspectionPlansByVehicleAsync(vehicleId, cancellationToken)).ToList();
                break;
            case AssignmentPlanType.Maintenance when vehicleId != Guid.Empty:
                planningOptions = (await FleetRepository.GetMaintenancePlanByVehicleAsync(vehicleId, cancellationToken)).ToList();
                break;
            default:
                break;
        }
    }

    private Task<IEnumerable<PostOffice>> SearchPostOffices(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<PostOffice>>(postOffices);
        }

        IEnumerable<PostOffice> results = postOffices.Where(postOffice =>
            postOffice.PostOfficeCode.Contains(value, StringComparison.OrdinalIgnoreCase)
            || postOffice.PostOfficeName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    private Task<IEnumerable<Driver>> SearchDrivers(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<Driver>>(drivers);
        }

        IEnumerable<Driver> results = drivers
            .OrderByDescending(driver =>
                    driver.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
                    || driver.Code.Contains(value, StringComparison.OrdinalIgnoreCase)
                    || driver.Email.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(results);
    }

    private Task OnDriverChanged(Driver? driver)
    {
        SelectedDriver = driver;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        string apiPath = GetApiPath();
        if (string.IsNullOrWhiteSpace(apiPath))
        {
            Snackbar.Add("Hành động này chưa hỗ trợ.", Severity.Warning);
            return;
        }

        if (vehicleId == Guid.Empty || pairingReasonTypeId == Guid.Empty || planningId == Guid.Empty)
        {
            Snackbar.Add("Vui lòng chọn xe, lý do ghép và kế hoạch.", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            PairingRequest request = new()
            {
                VehicleId = vehicleId,
                PairingReasonTypeId = pairingReasonTypeId,
                Odometer = odometer,
                Address = address,
                ActionType = actionType,
                CheckStatus = 2,
                PlanningType = planningType,
                PlanningId = planningId,
                AutoCreateMaintenancePlan = autoCreateMaintenancePlan,
                PostOfficeCode = postOfficeCode,
                AssignmentImages = BuildAssignmentImages()
            };

            using HttpClient client = HttpClientFactory.CreateClient();
            using HttpRequestMessage httpRequest = new(HttpMethod.Post, BuildApiUrl(apiPath))
            {
                Content = JsonContent.Create(request)
            };

            if (!string.IsNullOrWhiteSpace(accessToken))
            {
                httpRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", accessToken.Trim());
            }

            if (Guid.TryParse(companyId, out Guid companyGuid))
            {
                httpRequest.Headers.Add("CompanyId", companyGuid.ToString());
            }

            if (Guid.TryParse(departmentId, out Guid departmentGuid))
            {
                httpRequest.Headers.Add("DepartmentId", departmentGuid.ToString());
            }

            HttpResponseMessage response = await client.SendAsync(httpRequest);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Gửi yêu cầu ghép xe thành công.", Severity.Success);
                return;
            }

            string error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Gửi yêu cầu thất bại: {(int)response.StatusCode} {response.ReasonPhrase}. {error}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gửi yêu cầu thất bại: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static List<PairingAssignmentImage> BuildAssignmentImages()
    {
        return Enumerable.Range(1, 6)
            .Select(type => new PairingAssignmentImage { ImageId = Guid.Empty, Type = type })
            .ToList();
    }

    private string BuildApiUrl(string apiPath)
    {
        if (string.IsNullOrWhiteSpace(apiHost))
        {
            return apiPath;
        }

        string trimmedHost = apiHost.Trim().TrimEnd('/');
        return $"{trimmedHost}{apiPath}";
    }

    private string GetApiPath()
    {
        return actionType switch
        {
            ActionType.Pairing => PairingApiPath,
            ActionType.Unpairing => UnpairingApiPath,
            ActionType.UnexpectedPairing => UnexpectedApiPath,
            _ => string.Empty
        };
    }
}