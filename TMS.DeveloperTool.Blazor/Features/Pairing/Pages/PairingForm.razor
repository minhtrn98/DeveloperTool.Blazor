@page "/pairing"
@using TMS.DeveloperTool.Blazor.Domain.Enums
@using TMS.DeveloperTool.Blazor.Features.Pairing.Contracts
@using TMS.DeveloperTool.Blazor.Features.Pairing.Models
@using TMS.DeveloperTool.Blazor.Features.Pairing.Services
@using TMS.DeveloperTool.Blazor.Features.Routing.Models
@using TMS.DeveloperTool.Blazor.Infrastructure.Http
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Dtos
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Interfaces
@using TMS.DeveloperTool.Blazor.Services
@inject FleetRepository FleetRepository
@inject RouteRepository RouteRepository
@inject PlanningRepository PlanningRepository
@inject DriverRepository DriverRepository
@inject IVehicleStatusApi VehicleStatusApi
@inject MyEmployeeService MyEmployeeService
@inject PairingService PairingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<AppPageTitle MenuName="Ghép xe" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">Ghép xe</MudText>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <MudForm>
                <MudAutocomplete T="VehicleDropdownItemDto" Value="SelectedVehicleOption" ValueChanged="OnVehicleChanged"
                                 SearchFunc="SearchVehicleOptions" ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<VehicleDropdownItemDto>" Label="Xe"
                                 Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20" Class="mb-3" />

                <MudAutocomplete T="Employee" Value="SelectedDriver" ValueChanged="OnDriverChanged" SearchFunc="SearchDrivers"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<Employee>" Label="Tài xế" Variant="Variant.Outlined" FullWidth="true"
                                 Clearable="true" MaxItems="20" Class="mb-3" />

                <MudSelect T="Guid" @bind-Value="pairingReasonTypeId" Label="Lý do ghép xe" Variant="Variant.Outlined"
                           FullWidth="true" Class="mb-3">
                    @foreach (var item in pairingReasonTypes)
                    {
                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="ActionType" @bind-Value="actionType" Label="Hành động" Variant="Variant.Outlined"
                                   FullWidth="true" Class="mb-3">
                            @foreach (var item in actionTypes)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="double" @bind-Value="odometer" Label="Odometer" Variant="Variant.Outlined"
                                         FullWidth="true" Class="mb-3" />
                    </MudItem>
                </MudGrid>

                @if (actionType is ActionType.SwapMainDriver or ActionType.SwapSubDriver)
                {
                    <MudAutocomplete T="Employee" @bind-Value="selectedSwapDriver" SearchFunc="SearchDrivers"
                                     ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<Employee>" Label="Tài xế cần đổi" Variant="Variant.Outlined" FullWidth="true"
                                     Clearable="true" MaxItems="20" Class="mb-3" />
                }

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="AssignmentPlanType" @bind-Value="planningType"
                                   @bind-Value:after="OnPlanningTypeChanged" Label="Loại kế hoạch" Variant="Variant.Outlined"
                                   FullWidth="true" Class="mb-3">
                            @foreach (var item in planningTypes)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <div class="d-flex align-end gap-2">
                            <MudAutocomplete T="PlanningDropdownItemDto" @bind-Value="SelectedPlanningOption"
                                             SearchFunc="SearchPlanningOptions" ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<PlanningDropdownItemDto>" Label="Kế hoạch"
                                             Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20" Class="mb-3" />
                            @if (planningType == AssignmentPlanType.DailyPlan)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Class="mb-3"
                                           OnClick="SuggestDailyPlansAsync" Disabled="@isSuggesting">
                                    @if (isSuggesting)
                                    {
                                        <MudProgressCircular Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <MudText>Gợi ý</MudText>
                                    }
                                </MudButton>
                            }
                        </div>
                    </MudItem>
                </MudGrid>

                <MudAutocomplete T="PostOffice" @bind-Value="SelectedPostOffice" SearchFunc="SearchPostOffices"
                                 ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<PostOffice>" Label="Bưu cục" Variant="Variant.Outlined" FullWidth="true"
                                 Clearable="true" MaxItems="20" Class="mb-3" />

                <MudSwitch @bind-Value="autoCreateMaintenancePlan" Color="Color.Primary"
                           Label="Tự động tạo kế hoạch bảo trì" Class="mb-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSubmitting" OnClick="SubmitAsync">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <MudText>Đang gửi...</MudText>
                    }
                    else
                    {
                        <MudText>Gửi yêu cầu</MudText>
                    }
                </MudButton>
            </MudForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private string accessToken = string.Empty;

    private Guid vehicleId;
    private Guid pairingReasonTypeId;
    private ActionType actionType;
    private AssignmentPlanType planningType;
    private Guid planningId;
    private double odometer = 0;
    private bool autoCreateMaintenancePlan = true;

    private List<VehicleDropdownItemDto> vehicleOptions = [];
    private List<DropdownItemDto<Guid>> pairingReasonTypes = [];
    private List<DropdownItemDto<ActionType>> actionTypes = [];
    private List<DropdownItemDto<AssignmentPlanType>> planningTypes = [];
    private List<PlanningDropdownItemDto> planningOptions = [];
    private List<PostOffice> postOffices = [];
    private List<Employee> emps = [];

    private VehicleDropdownItemDto? selectedVehicleOption;
    private PlanningDropdownItemDto? selectedPlanningOption;
    private PostOffice? selectedPostOffice;
    private Employee? selectedDriver;
    private Employee? selectedSwapDriver;
    private string address = string.Empty;
    private string postOfficeCode = string.Empty;

    private bool isLoading = true;
    private bool isSubmitting;
    private bool isSuggesting;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        isLoading = true;
        try
        {
            CancellationToken cancellationToken = CancellationToken.None;

            vehicleOptions = await FleetRepository.GetVehicleDropdownItemsAsync(isPairingAllowed: true, cancellationToken);

            pairingReasonTypes = (await FleetRepository.GetPairingReasonTypesAsync(cancellationToken)).ToList();
            actionTypes = FleetRepository.GetActionTypes().ToList();
            planningTypes = FleetRepository.GetAssignmentPlanTypes().ToList();
            postOffices = (await RouteRepository.GetPostOfficesAsync(cancellationToken))
                .OrderBy(x => x.PostOfficeCode)
                .ToList();
            emps = (await MyEmployeeService.GetAllEmployeesAsync(cancellationToken))
                .OrderBy(x => x.Code)
                .ThenBy(x => x.Name)
                .ToList();

            SelectedVehicleOption = null;
            pairingReasonTypeId = pairingReasonTypes.FirstOrDefault()?.Id ?? Guid.Empty;
            actionType = ActionType.Pairing;
            planningType = AssignmentPlanType.DailyPlan;
            SelectedPlanningOption = null;
            SelectedPostOffice = null;
            SelectedDriver = null;
            await LoadPlanningOptionsAsync(cancellationToken);
        }
        finally
        {
            isLoading = false;
        }
    }

    private VehicleDropdownItemDto? SelectedVehicleOption
    {
        get => selectedVehicleOption;
        set
        {
            selectedVehicleOption = value;
            vehicleId = value?.Id ?? Guid.Empty;
        }
    }

    private async Task OnVehicleChanged(VehicleDropdownItemDto? value)
    {
        SelectedVehicleOption = value;

        if (vehicleId == Guid.Empty)
        {
            odometer = 0;
            SelectedDriver = null;
            return;
        }

        try
        {
            await TrySelectDriverByVehicleAsync(value, CancellationToken.None);

            LatestAssignmentDto? latestAssignment = await FleetRepository.GetLatestAssignmentAsync(vehicleId);

            if (latestAssignment?.Odometer is not null)
            {
                odometer = (double)latestAssignment.Odometer.Value;
            }
            else
            {
                odometer = await FleetRepository.GetVehicleOdometerAsync(vehicleId);
            }

            if (latestAssignment?.PlanningType is not null)
            {
                planningType = latestAssignment.PlanningType.Value;
            }

            await LoadPlanningOptionsAsync(CancellationToken.None);

            if (latestAssignment?.PlanningId is not null)
            {
                SelectedPlanningOption = planningOptions.FirstOrDefault(plan => plan.Id == latestAssignment.PlanningId.Value);
            }

            if (!string.IsNullOrWhiteSpace(latestAssignment?.Address))
            {
                string startOfficeCode = latestAssignment.Address[..3];
                SelectedPostOffice = postOffices.FirstOrDefault(postOffice =>
                    postOffice.PostOfficeCode == startOfficeCode);
            }

            if (!string.IsNullOrWhiteSpace(latestAssignment?.Address))
            {
                address = latestAssignment.Address;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi xảy ra: {ex.Message}", Severity.Warning);
        }
    }

    private async Task TrySelectDriverByVehicleAsync(VehicleDropdownItemDto? selectedVehicle, CancellationToken cancellationToken)
    {
        if (selectedVehicle is null)
        {
            SelectedDriver = null;
            return;
        }

        string plate = selectedVehicle.LicensePlate
            .Replace("-", string.Empty, StringComparison.Ordinal)
            .Replace(".", string.Empty, StringComparison.Ordinal)
            .Trim();

        if (string.IsNullOrWhiteSpace(plate))
        {
            SelectedDriver = null;
            return;
        }

        VehicleStatusResponseDto response = await VehicleStatusApi.GetVehicleStatusAsync(plate, cancellationToken);
        string? licenseNo = response.Data.FirstOrDefault()?.LicenseNo;

        if (string.IsNullOrWhiteSpace(licenseNo))
        {
            SelectedDriver = null;
            return;
        }

        EmployeeDto? employee = await DriverRepository.GetEmployeeByLicenseNoAsync(licenseNo, cancellationToken);
        if (employee is null)
        {
            SelectedDriver = null;
            return;
        }

        Employee? matchedEmployee = emps.FirstOrDefault(e => e.EmployeeId == employee.Id)
            ?? emps.FirstOrDefault(e => e.Code.Equals(employee.Code, StringComparison.OrdinalIgnoreCase));

        if (matchedEmployee is null)
        {
            matchedEmployee = new Employee
            {
                EmployeeId = employee.Id,
                Code = employee.Code,
                Name = employee.Name
            };
            emps.Add(matchedEmployee);
        }

        SelectedDriver = matchedEmployee;
    }

    private PlanningDropdownItemDto? SelectedPlanningOption
    {
        get => selectedPlanningOption;
        set
        {
            selectedPlanningOption = value;
            planningId = value?.Id ?? Guid.Empty;

            // Auto-select SelectedPostOffice based on FirstStop
            if (!string.IsNullOrWhiteSpace(value?.FirstStop))
            {
                SelectedPostOffice = postOffices.FirstOrDefault(postOffice =>
                    postOffice.PostOfficeCode == value.FirstStop);
            }
            else
            {
                SelectedPostOffice = null;
            }
        }
    }

    private PostOffice? SelectedPostOffice
    {
        get => selectedPostOffice;
        set
        {
            selectedPostOffice = value;
            postOfficeCode = value?.PostOfficeCode ?? string.Empty;
            address = value == null ? string.Empty : $"{value.PostOfficeCode} - {value.PostOfficeName}";
        }
    }

    private Employee? SelectedDriver
    {
        get => selectedDriver;
        set
        {
            selectedDriver = value;
            accessToken = value?.BearerToken ?? string.Empty;
        }
    }

    private Task<IEnumerable<VehicleDropdownItemDto>> SearchVehicleOptions(string value, CancellationToken cancellationToken)
    {
        IEnumerable<VehicleDropdownItemDto> results = AutocompleteSearchHelper.SearchByLike(vehicleOptions, value);
        return Task.FromResult(results);
    }

    private Task<IEnumerable<PlanningDropdownItemDto>> SearchPlanningOptions(string value, CancellationToken cancellationToken)
    {
        IEnumerable<PlanningDropdownItemDto> results = AutocompleteSearchHelper.SearchByLike(planningOptions, value);
        return Task.FromResult(results);
    }

    private async Task OnPlanningTypeChanged()
    {
        await LoadPlanningOptionsAsync(CancellationToken.None);
    }

    private async Task LoadPlanningOptionsAsync(CancellationToken cancellationToken)
    {
        planningOptions = [];
        SelectedPlanningOption = null;

        switch (planningType)
        {
            case AssignmentPlanType.DailyPlan:
                planningOptions = (await PlanningRepository.GetDailyPlanDropdownItemsAsync(cancellationToken)).ToList();
                break;
            case AssignmentPlanType.Inspection when vehicleId != Guid.Empty:
                planningOptions = (await FleetRepository.GetInspectionPlansByVehicleAsync(vehicleId, cancellationToken)).ToList();
                break;
            case AssignmentPlanType.Maintenance when vehicleId != Guid.Empty:
                planningOptions = (await FleetRepository.GetMaintenancePlansByVehicleAsync(vehicleId, cancellationToken)).ToList();
                break;
            default:
                break;
        }
    }

    private Task<IEnumerable<PostOffice>> SearchPostOffices(string value, CancellationToken cancellationToken)
    {
        IEnumerable<PostOffice> results = AutocompleteSearchHelper.SearchByLike(postOffices, value);
        return Task.FromResult(results);
    }

    private Task<IEnumerable<Employee>> SearchDrivers(string value, CancellationToken cancellationToken)
    {
        IEnumerable<Employee> results = AutocompleteSearchHelper.SearchByLike(emps, value);
        return Task.FromResult(results);
    }

    private Task OnDriverChanged(Employee? driver)
    {
        SelectedDriver = driver;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (actionType is not (ActionType.Pairing or ActionType.Unpairing or ActionType.UnexpectedPairing
            or ActionType.SwapMainDriver or ActionType.SwapSubDriver))
        {
            Snackbar.Add("Hành động này chưa hỗ trợ.", Severity.Warning);
            return;
        }

        if (vehicleId == Guid.Empty || pairingReasonTypeId == Guid.Empty || planningId == Guid.Empty)
        {
            Snackbar.Add("Vui lòng chọn xe, lý do ghép và kế hoạch.", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            if (actionType is ActionType.Pairing or ActionType.Unpairing or ActionType.UnexpectedPairing)
            {
                await SendPairingAsync();
            }
            else
            {
                await SendRequestSwapDriverAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gửi yêu cầu thất bại: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SendPairingAsync()
    {
        PairingRequest request = new()
        {
            VehicleId = vehicleId,
            PairingReasonTypeId = pairingReasonTypeId,
            Odometer = odometer,
            Address = address,
            ActionType = actionType,
            CheckStatus = 2,
            PlanningType = planningType,
            PlanningId = planningId,
            AutoCreateMaintenancePlan = autoCreateMaintenancePlan,
            PostOfficeCode = postOfficeCode,
            AssignmentImages = BuildAssignmentImages()
        };

        ApiCallResult result = await PairingService.SendPairingAsync(
            accessToken,
            request);
        if (result.IsSuccess)
        {
            Snackbar.Add("Gửi yêu cầu ghép xe thành công.", Severity.Success);
            return;
        }

        Snackbar.Add($"Gửi yêu cầu thất bại: {result.ErrorMessage}", Severity.Error);
    }

    private async Task SendRequestSwapDriverAsync()
    {
        if (selectedSwapDriver == null)
        {
            Snackbar.Add("Vui lòng chọn tài xế cần đổi.", Severity.Warning);
            return;
        }

        SwapDriverRequest request = new()
        {
            VehicleId = vehicleId,
            Odometer = odometer,
            ActionType = actionType,
            DriverRequest = selectedSwapDriver.EmployeeId
        };

        ApiCallResult result = await PairingService.SendSwapDriverAsync(
            accessToken,
            request);
        if (result.IsSuccess)
        {
            Snackbar.Add("Gửi yêu cầu đổi tài xế thành công.", Severity.Success);
            return;
        }

        Snackbar.Add($"Gửi yêu cầu thất bại: {result.ErrorMessage}", Severity.Error);
    }

    private static List<PairingAssignmentImage> BuildAssignmentImages()
    {
        return Enumerable.Range(1, 6)
            .Select(type => new PairingAssignmentImage { ImageId = Guid.Empty, Type = type })
            .ToList();
    }

    private async Task SuggestDailyPlansAsync()
    {
        isSuggesting = true;
        try
        {
            List<DailyPlanDto> dailyPlans = (await PlanningRepository.GetDailyPlansAsync("PENDING", CancellationToken.None)).ToList();

            DialogParameters<DailyPlanSuggestionDialog> parameters = new()
            {
                { x => x.DailyPlans, dailyPlans }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true
            };

            IDialogReference dialog = await DialogService.ShowAsync<DailyPlanSuggestionDialog>("Gợi ý kế hoạch ngày", parameters, options);
            DialogResult? dialogResult = await dialog.Result;

            if (dialogResult is { Canceled: false, Data: DailyPlanDto selectedPlan })
            {
                SelectedPlanningOption = planningOptions.FirstOrDefault(p => p.Id == selectedPlan.Id)
                    ?? new PlanningDropdownItemDto(selectedPlan.Id, selectedPlan.Code, selectedPlan.Name, selectedPlan.Status, selectedPlan.DepartmentCode);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi tải gợi ý: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSuggesting = false;
        }
    }

}