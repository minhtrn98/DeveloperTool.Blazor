@using TMS.DeveloperTool.Blazor.Features.OrderStep1.Models

@if (Rows.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">Không có thay đổi trạng thái nào được ghi nhận.</MudAlert>
}
else
{
    <div style="overflow-x: auto;">
        <MudSimpleTable Dense="true" Hover="true" Style="width: max-content; min-width: 100%;">
            <thead>
                <tr>
                    <th style="position: sticky; left: 0; z-index: 1; background: var(--mud-palette-surface);">@HeaderLabel</th>
                    @foreach (DateTimeOffset timestamp in Timestamps)
                    {
                        <th style="white-space: nowrap;">@timestamp.ToString("dd/MM/yyyy HH:mm:ss")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (OrderFieldTimelineRow row in Rows)
                {
                    <tr>
                        <td style="position: sticky; left: 0; font-weight: 600; background: var(--mud-palette-surface); white-space: nowrap;">
                            @row.FieldName
                        </td>
                        @for (int i = 0; i < row.Values.Count; i++)
                        {
                            string? value = row.Values[i];
                            bool changed = i > 0 && value != row.Values[i - 1];
                            <td style="@(changed ? "color: var(--mud-palette-primary); font-weight: 600;" : null) white-space: nowrap;">
                                @(value ?? "—")
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<DateTimeOffset> Timestamps { get; set; } = [];

    [Parameter, EditorRequired]
    public List<OrderFieldTimelineRow> Rows { get; set; } = [];

    [Parameter]
    public string HeaderLabel { get; set; } = "Trường";
}
