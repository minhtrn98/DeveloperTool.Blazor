@page "/pro/pickup-task-order-item-timeline"
@using System.Globalization
@using TMS.DeveloperTool.Blazor.Features.PickupTaskOrderTimeline.Services
@inject PickupTaskOrderProStorageService StorageService

<AppPageTitle MenuName="Pro - Điều tin - Order item timeline" />

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-4">Pro - Điều tin - Order item timeline</MudText>

        <div class="d-flex align-center ga-2">
            <MudTextField T="string" @bind-Value="searchText" Label="Order Item Id" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Clearable="true" Immediate="true" OnKeyUp="OnSearchKeyUpAsync" Class="flex-grow-0" Style="width: 360px; max-width: 100%;" />
            <MudButton OnClick="SearchAsync" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(string.IsNullOrWhiteSpace(searchText) || isLoading)">Tìm kiếm</MudButton>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (searchedId is null)
    {
        <MudAlert Severity="Severity.Info">Nhập Order Item Id để xem timeline.</MudAlert>
    }
    else if (items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Không có dữ liệu điều tin nào được ghi nhận cho order item này.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mb-2 d-block">Giá trị khác với lần ghi nhận trước được tô màu.</MudText>

        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h5" Class="mb-2">Order Item</MudText>
            <MudTable Items="items" Dense="true" Hover="true" HorizontalScrollbar="true">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Thời gian</MudTh>
                    <MudTh>Order Id</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>IsProcessCompleted</MudTh>
                    <MudTh>Weight</MudTh>
                    <MudTh>RealWeight</MudTh>
                    <MudTh>Pickup Task Id</MudTh>
                    <MudTh>Trace Id</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        int index = items.IndexOf(context);
                        PickupTaskOrderItem? previous = index > 0 ? items[index - 1] : null;
                    }
                    <MudTd DataLabel="STT">@(index + 1)</MudTd>
                    <MudTd DataLabel="Thời gian">@FormatTime(context.CreatedAt)</MudTd>
                    <MudTd DataLabel="Order Id">@Cell(context.OrderId, previous?.OrderId)</MudTd>
                    <MudTd DataLabel="Status">@Cell(context.Status.Description, previous?.Status.Description)</MudTd>
                    <MudTd DataLabel="IsProcessCompleted">@Cell(FormatBool(context.IsProcessCompleted), previous is null ? null : FormatBool(previous.IsProcessCompleted))</MudTd>
                    <MudTd DataLabel="Weight">@Cell(FormatDecimal(context.Weight), previous is null ? null : FormatDecimal(previous.Weight))</MudTd>
                    <MudTd DataLabel="RealWeight">@Cell(FormatDecimal(context.RealWeight), previous is null ? null : FormatDecimal(previous.RealWeight))</MudTd>
                    <MudTd DataLabel="Pickup Task Id">@Cell(context.PickupTaskId, previous?.PickupTaskId)</MudTd>
                    <MudTd DataLabel="Trace Id">@context.TraceId</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudContainer>

@code {
    private string? searchText;
    private string? searchedId;
    private List<PickupTaskOrderItem> items = [];
    private bool isLoading;

    private async Task OnSearchKeyUpAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        string? id = searchText?.Trim();
        if (string.IsNullOrEmpty(id))
        {
            return;
        }

        searchedId = id;
        items = [];

        isLoading = true;
        try
        {
            items = await StorageService.GetItemsByOrderItemIdAsync(searchedId, CancellationToken.None);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static RenderFragment Cell(string value, string? previousValue) => __builder =>
    {
        bool changed = previousValue is not null && value != previousValue;
        <MudText Typo="Typo.body2" Color="@(changed ? Color.Primary : Color.Default)">
            @if (changed)
            {
                <b>@value</b>
            }
            else
            {
                @value
            }
        </MudText>
    };

    private static string FormatTime(DateTimeOffset value) => VietnamTimeHelper.Format(value);

    private static string FormatDecimal(decimal value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string FormatBool(bool value) => value ? "true" : "false";
}
