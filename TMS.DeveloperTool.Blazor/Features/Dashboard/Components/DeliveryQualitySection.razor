@using TMS.DeveloperTool.Blazor.Features.Dashboard.Models
@using TMS.DeveloperTool.Blazor.Features.Dashboard.Services
@using TMS.DeveloperTool.Blazor.Features.Report.Models

<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
            <MudText Typo="Typo.h6">Chất lượng check-in điểm giao</MudText>
            <MudText Typo="Typo.caption" Class="mb-3 d-block">Khoảng cách từ vị trí check-in tới địa chỉ giao, và GPS có hợp lệ không.</MudText>

            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="4">
                    <DashboardStatTile Title="GPS hợp lệ" Value="@DashboardAggregator.FormatPercent(gpsValid, gpsKnown)" Caption="@($"{gpsInvalid:N0} không hợp lệ")"
                                       ValueColor="Color.Success" />
                </MudItem>
                <MudItem xs="4">
                    <DashboardStatTile Title="Check-in lại" Value="@DashboardAggregator.FormatPercent(superseded, arrivals)" Caption="@($"{superseded:N0} lần")" />
                </MudItem>
                <MudItem xs="4">
                    <DashboardStatTile Title="Cách xa ≥ 500m" Value="@DashboardAggregator.FormatPercent(farAway, withDistance)" Caption="@($"{farAway:N0} lần")"
                                       ValueColor="@(farAway > 0 ? Color.Warning : Color.Default)" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2">Phân bố khoảng cách (số check-in)</MudText>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@distanceSeries" XAxisLabels="@distanceLabels" Width="100%" Height="260px"
                      AxisChartOptions="axisOptions" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
            <MudText Typo="Typo.h6">Giao thất bại theo loại</MudText>
            @if (failureTypes.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-4">Không có dữ liệu.</MudText>
            }
            else
            {
                <MudChart ChartType="ChartType.Donut" InputData="@failureTypes.Select(x => (double)x.Count).ToArray()"
                          InputLabels="@failureTypes.Select(x => $"{x.Label} ({x.Count:N0})").ToArray()"
                          Width="100%" Height="260px" LegendPosition="Position.Bottom" />
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%">
            <MudText Typo="Typo.h6">Chuyển đơn theo nguồn</MudText>
            <MudText Typo="Typo.caption" Class="d-block">Driver: tài xế → tài xế. Employee: nhân viên bưu cục → tài xế.</MudText>
            @if (transferSources.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-4">Không có dữ liệu.</MudText>
            }
            else
            {
                <MudChart ChartType="ChartType.Donut" InputData="@transferSources.Select(x => (double)x.Count).ToArray()"
                          InputLabels="@transferSources.Select(x => $"{x.Label} ({x.Count:N0})").ToArray()"
                          Width="100%" Height="260px" LegendPosition="Position.Bottom" />
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly double[] MeterEdges = [50, 100, 200, 500, 1000, 5000];

    [Parameter, EditorRequired]
    public ReportDataSet Data { get; set; } = ReportDataSet.Empty;

    private readonly AxisChartOptions axisOptions = DashboardChartOptions.Axis();
    private ReportDataSet? lastData;
    private int arrivals;
    private int gpsValid;
    private int gpsInvalid;
    private int gpsKnown;
    private int superseded;
    private int withDistance;
    private int farAway;
    private List<LabelCount> failureTypes = [];
    private List<LabelCount> transferSources = [];
    private List<ChartSeries> distanceSeries = [];
    private string[] distanceLabels = [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(lastData, Data))
        {
            return;
        }

        lastData = Data;
        List<LabelCount> gps = DashboardAggregator.BuildLabelCounts(Data.LabelCounts, ReportMetric.ArrivalGps);
        arrivals = gps.Sum(x => x.Count);
        gpsValid = gps.FirstOrDefault(x => x.Label == "valid")?.Count ?? 0;
        gpsInvalid = gps.FirstOrDefault(x => x.Label == "invalid")?.Count ?? 0;
        gpsKnown = gpsValid + gpsInvalid;
        superseded = DashboardAggregator.BuildLabelCounts(Data.LabelCounts, ReportMetric.ArrivalSuperseded).FirstOrDefault(x => x.Label == "superseded")?.Count ?? 0;
        failureTypes = DashboardAggregator.BuildLabelCounts(Data.LabelCounts, ReportMetric.FailureType);
        transferSources = DashboardAggregator.BuildLabelCounts(Data.LabelCounts, ReportMetric.TransferSource);

        withDistance = DashboardAggregator.CountAtLeast(Data.Histograms, ReportMetric.ArrivalDistance, 0);
        farAway = DashboardAggregator.CountAtLeast(Data.Histograms, ReportMetric.ArrivalDistance, 500);

        BucketedCounts buckets = DashboardAggregator.Rebucket(Data.Histograms, ReportMetric.ArrivalDistance, MeterEdges, m => m < 1000 ? $"{m}m" : $"{m / 1000}km");
        distanceLabels = buckets.Labels;
        distanceSeries = [new ChartSeries { Name = "Số check-in", Data = buckets.Counts }];
    }
}
