@using TMS.DeveloperTool.Blazor.Features.Dashboard.Models
@using TMS.DeveloperTool.Blazor.Features.Dashboard.Services
@using TMS.DeveloperTool.Blazor.Features.Report.Models
@using TMS.DeveloperTool.Blazor.Features.Report.Services

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">Vòng đời sổ phát: tạo → check-in đầu tiên → xác nhận phát cuối cùng</MudText>
    <MudText Typo="Typo.caption" Class="mb-3 d-block">
        Ghép theo mã sổ phát ({DE}). Tính các sổ tạo trong khoảng đã chọn, gồm cả tạo bằng quét mã bàn giao.
        Chỉ tính check-in và xác nhận phát trong vòng 2 ngày sau ngày tạo sổ.
    </MudText>

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="6" md="2">
            <DashboardStatTile Title="Sổ phát đã tạo" Value="@total.ToString("N0")" />
        </MudItem>
        <MudItem xs="6" md="2">
            <DashboardStatTile Title="Có check-in" Value="@DashboardAggregator.FormatPercent(withArrival, total)" Caption="@($"{withArrival:N0} sổ")" />
        </MudItem>
        <MudItem xs="6" md="2">
            <DashboardStatTile Title="Có xác nhận phát" Value="@DashboardAggregator.FormatPercent(withComplete, total)" Caption="@($"{withComplete:N0} sổ")" />
        </MudItem>
        <MudItem xs="6" md="2">
            <DashboardStatTile Title="Chưa có hoạt động" Value="@idle.ToString("N0")" Caption="Không check-in, không phát"
                               ValueColor="@(idle > 0 ? Color.Warning : Color.Default)" />
        </MudItem>
        <MudItem xs="6" md="2">
            <DashboardStatTile Title="Trung vị tạo → check-in" Value="@DashboardAggregator.FormatDuration(toArrival.Median)" Caption="@($"P90 {DashboardAggregator.FormatDuration(toArrival.P90)}")" />
        </MudItem>
        <MudItem xs="6" md="2">
            <DashboardStatTile Title="Trung vị tạo → phát xong" Value="@DashboardAggregator.FormatDuration(toComplete.Median)" Caption="@($"P90 {DashboardAggregator.FormatDuration(toComplete.P90)}")" />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.subtitle2">Phân bố thời gian (số sổ phát)</MudText>
    <MudChart ChartType="ChartType.Bar" ChartSeries="@series" XAxisLabels="@labels" Width="100%" Height="300px" AxisChartOptions="axisOptions" />
</MudPaper>

@code {
    private static readonly double[] HourEdges = [0.5, 1, 2, 4, 6, 8, 12];
    private static readonly double[] SecondEdges = HourEdges.Select(h => h * 3600).ToArray();

    [Parameter, EditorRequired]
    public ReportDataSet Data { get; set; } = ReportDataSet.Empty;

    private readonly AxisChartOptions axisOptions = DashboardChartOptions.Axis();
    private ReportDataSet? lastData;
    private int total;
    private int withArrival;
    private int withComplete;
    private int idle;
    private DurationStats toArrival = DurationStats.Empty;
    private DurationStats toComplete = DurationStats.Empty;
    private List<ChartSeries> series = [];
    private string[] labels = [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(lastData, Data))
        {
            return;
        }

        lastData = Data;
        total = Data.ManifestDays.Sum(x => x.Created);
        withArrival = Data.ManifestDays.Sum(x => x.WithArrival);
        withComplete = Data.ManifestDays.Sum(x => x.WithComplete);
        idle = Data.ManifestDays.Sum(x => x.Idle);

        double[] edges = DailyReportAggregator.DurationEdgesSeconds;
        toArrival = DurationStats.FromSeconds(DashboardAggregator.BuildHistogramStats(Data.Histograms, ReportMetric.ManifestFirstArrival, edges));
        toComplete = DurationStats.FromSeconds(DashboardAggregator.BuildHistogramStats(Data.Histograms, ReportMetric.ManifestLastComplete, edges));

        BucketedCounts arrivalBuckets = DashboardAggregator.Rebucket(Data.Histograms, ReportMetric.ManifestFirstArrival, SecondEdges, FormatSeconds);
        BucketedCounts completeBuckets = DashboardAggregator.Rebucket(Data.Histograms, ReportMetric.ManifestLastComplete, SecondEdges, FormatSeconds);
        labels = arrivalBuckets.Labels;
        series =
        [
            new ChartSeries { Name = "Tạo → check-in đầu tiên", Data = arrivalBuckets.Counts },
            new ChartSeries { Name = "Tạo → xác nhận phát cuối cùng", Data = completeBuckets.Counts }
        ];
    }

    private static string FormatSeconds(double seconds) => seconds < 3600 ? $"{seconds / 60}p" : $"{seconds / 3600}h";
}
