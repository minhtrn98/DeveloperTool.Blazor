<MudPaper Elevation="1" Class="pa-3" Style="height: 100%">
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@Title</MudText>
    <MudText Typo="Typo.h5" Color="@ValueColor">@Value</MudText>
    @if (!string.IsNullOrEmpty(Caption))
    {
        <MudText Typo="Typo.caption" Class="d-block">@Caption</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Caption { get; set; }

    [Parameter]
    public Color ValueColor { get; set; } = Color.Default;
}
