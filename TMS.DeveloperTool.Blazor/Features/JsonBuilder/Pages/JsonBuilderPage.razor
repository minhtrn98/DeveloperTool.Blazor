@page "/json-builder"
@using TMS.DeveloperTool.Blazor.Features.JsonBuilder.Services
@using TMS.DeveloperTool.Blazor.Features.JsonBuilder.Models
@using MudBlazor
@inject JsonBuilderService JsonBuilderService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<AppPageTitle MenuName="JSON Builder" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-4">JSON Builder</MudText>

        <MudSelect T="string" Value="SelectedJsonType" ValueChanged="OnJsonTypeChanged" Label="JSON Type"
                   Variant="Variant.Outlined" Class="mb-4">
            @foreach (var jsonType in JsonTypes)
            {
                <MudSelectItem T="string" Value="@jsonType">@jsonType</MudSelectItem>
            }
        </MudSelect>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="JsonInput" Label="Nhập JSON" Lines="38" Variant="Variant.Outlined" />
                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ParseJson">Parse JSON</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CopyJsonToClipboard"
                               Disabled="@string.IsNullOrWhiteSpace(JsonInput)">Copy</MudButton>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="6">
                @if (JsonKeys.Count > 0)
                {
                    <MudText Typo="Typo.h6" Class="mb-2">Supported Selectors</MudText>
                    <MudList T="JsonKey">
                        @foreach (var key in JsonKeys.Where(k => k.IsSupported))
                        {
                            <MudListItem T="JsonKey">
                                <MudText><strong>@key.Path:</strong> @key.CurrentValue</MudText>
                                @if (key.Options.Count > 0)
                                {
                                    <MudSelect T="object" Value="@key.CurrentValue" ValueChanged="v => OnValueChanged(key, v)"
                                               Label="@key.KeyName" Variant="Variant.Outlined" Class="ml-4" Style="width: 260px;">
                                        @foreach (var option in key.Options)
                                        {
                                            <MudSelectItem T="object" Value="@option">@GetOptionText(option)</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private List<string> JsonTypes { get; set; } = new();
    private string SelectedJsonType { get; set; } = string.Empty;
    private string JsonInput { get; set; } = string.Empty;
    private List<JsonKey> JsonKeys { get; set; } = new();

    protected override void OnInitialized()
    {
        JsonTypes = JsonBuilderService.GetJsonTypes().ToList();
        SelectedJsonType = JsonTypes.FirstOrDefault() ?? string.Empty;
    }

    private async Task ParseJson()
    {
        if (string.IsNullOrWhiteSpace(JsonInput))
        {
            JsonKeys.Clear();
            Snackbar.Add("Please enter JSON content.", Severity.Warning);
            return;
        }

        JsonKeys = await JsonBuilderService.ParseJsonAndExtractKeys(JsonInput, SelectedJsonType);
        await JsonBuilderService.LoadDropdownOptionsAsync(JsonKeys, SelectedJsonType);

        if (JsonKeys.Count == 0)
        {
            Snackbar.Add("Unable to parse JSON or no keys were found.", Severity.Info);
        }
    }

    private async Task OnValueChanged(JsonKey key, object newValue)
    {
        JsonInput = await JsonBuilderService.ApplyValueChange(JsonInput, SelectedJsonType, JsonKeys, key, newValue);
    }

    private static string GetOptionText(object? option)
    {
        return option?.ToString() ?? string.Empty;
    }

    private async Task CopyJsonToClipboard()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", JsonInput);
        Snackbar.Add("Copied JSON to clipboard.", Severity.Success);
    }

    private void OnJsonTypeChanged(string jsonType)
    {
        SelectedJsonType = jsonType;
        JsonKeys.Clear();
    }
}