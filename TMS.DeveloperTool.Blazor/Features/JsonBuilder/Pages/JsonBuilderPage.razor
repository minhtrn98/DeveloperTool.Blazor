@page "/json-builder"
@using TMS.DeveloperTool.Blazor.Features.JsonBuilder.Services
@using TMS.DeveloperTool.Blazor.Features.JsonBuilder.Models
@using MudBlazor
@inject JsonBuilderService JsonBuilderService

<AppPageTitle MenuName="JSON Builder" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-4">JSON Builder</MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="JsonInput" Label="Nhập JSON" Lines="20" Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ParseJson" Class="mt-4">Parse JSON</MudButton>
            </MudItem>
            <MudItem xs="12" md="6">
                @if (JsonKeys.Count > 0)
                {
                    <MudText Typo="Typo.h6" Class="mb-2">Supported Selectors</MudText>
                    <MudList T="JsonKey">
                        @foreach (var key in JsonKeys.Where(k => k.IsSupported))
                        {
                            <MudListItem T="JsonKey">
                                <MudText><strong>@key.Path:</strong> @key.CurrentValue</MudText>
                                @if (key.Options != null)
                                {
                                    <MudSelect T="string" Value="@(key.CurrentValue?.ToString())" ValueChanged="v => OnValueChanged(key, v)" Label="@key.KeyName" Variant="Variant.Outlined" Class="ml-4" Style="width: 200px;">
                                        @foreach (var option in key.Options)
                                        {
                                            <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private string JsonInput { get; set; } = "";
    private List<JsonKey> JsonKeys { get; set; } = new();

    private async Task ParseJson()
    {
        JsonKeys = JsonBuilderService.ParseJsonAndExtractKeys(JsonInput);
        await JsonBuilderService.LoadDropdownOptionsAsync(JsonKeys);
    }

    private void OnValueChanged(JsonKey key, string newValue)
    {
        key.CurrentValue = newValue;
        JsonInput = JsonBuilderService.UpdateJsonValue(JsonInput, key.Path, key.CurrentValue);
    }
}