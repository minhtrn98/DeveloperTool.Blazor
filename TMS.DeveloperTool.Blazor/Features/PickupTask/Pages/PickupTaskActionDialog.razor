@using TMS.DeveloperTool.Blazor.Features.PickupTask.Models
@using TMS.DeveloperTool.Blazor.Domain
@using TMS.DeveloperTool.Blazor.Domain.Enums
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Dtos

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle: @PickupTaskId</MudText>
    </TitleContent>
    <DialogContent>
        @if (RequiresOrderItemSelection)
        {
            @if (!orderItemSelections.Any())
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    Không có item đơn hàng nào.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Chọn item đơn hàng</MudText>
                <MudPaper Outlined="true" Class="pa-3 mb-4">
                    @foreach (IGrouping<string, OrderItemSelectionItem> orderGroup in orderItemSelections.GroupBy(item => item.OrderId))
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Order: @orderGroup.Key</MudText>
                        @foreach (OrderItemSelectionItem item in orderGroup)
                        {
                            <MudCheckBox T="bool" Value="@item.IsSelected" ValueChanged="@((bool value) => item.IsSelected = value)"
                                         Dense="true" Class="mb-1 pl-4">
                                <ChildContent>
                                    <div class="d-flex align-center ga-2">
                                        <span>@item.OrderItemId</span>
                                        <MudChip T="string" Color="@GetItemStatusColor(item.Status)" Variant="Variant.Outlined" Size="Size.Small">
                                            @GetItemStatusLabel(item.Status)
                                        </MudChip>
                                    </div>
                                </ChildContent>
                            </MudCheckBox>
                        }
                    }
                </MudPaper>
            }
        }

        <MudTextField @bind-Value="reason" Label="Lý do" Variant="Variant.Outlined" FullWidth="true" Lines="3"
                      AutoGrow="true" Class="mb-4" />

        @if (IsTransfer)
        {
            <MudSelect T="string" @bind-Value="selectedTargetDriverId" Label="Tài xế nhận điều tin" Variant="Variant.Outlined" FullWidth="true" Class="mb-4">
                <MudSelectItem T="string" Value="@string.Empty">Không chọn</MudSelectItem>
                @foreach (Employee driver in TransferDrivers)
                {
                    string driverId = driver.EmployeeId.ToString();
                    <MudSelectItem T="string" Value="@driverId">@GetDriverOptionLabel(driver)</MudSelectItem>
                }
            </MudSelect>
        }

        @if (IsReschedule)
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Ngày hẹn lấy lại" Variant="Variant.Outlined" Editable="true"
                                   @bind-Date="selectedDate" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Giờ hẹn lấy lại" Variant="Variant.Outlined" Editable="true" AmPm="false"
                                   @bind-Time="selectedTime" />
                </MudItem>
            </MudGrid>
        }

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
                @validationMessage
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Hủy</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">Xác nhận</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ActionName { get; set; } = string.Empty;

    [Parameter]
    public string PickupTaskId { get; set; } = string.Empty;

    [Parameter]
    public List<PickupTaskOrderDto> Orders { get; set; } = [];

    [Parameter]
    public List<PickupTaskOrderItemDto> OrderItems { get; set; } = [];

    [Parameter]
    public DateTime? InitialRescheduledPickupDt { get; set; }

    [Parameter]
    public List<Employee> TransferDrivers { get; set; } = [];

    [Parameter]
    public string? InitialTargetDriverId { get; set; }

    private readonly List<OrderItemSelectionItem> orderItemSelections = [];
    private string reason = string.Empty;
    private DateTime? selectedDate;
    private TimeSpan? selectedTime;
    private string selectedTargetDriverId = string.Empty;
    private string validationMessage = string.Empty;

    private bool IsReschedule => ActionName == "Reschedule";
    private bool IsCancel => ActionName == "Cancel";
    private bool IsTransfer => ActionName == "Transfer";
    private bool RequiresOrderItemSelection => ActionName is "Cancel" or "Reschedule";

    private string DialogTitle => ActionName switch
    {
        "Cancel" => "Hủy điều tin",
        "Reschedule" => "Hẹn lấy lại",
        "Transfer" => "Chuyển tiếp điều tin",
        _ => "Cập nhật điều tin"
    };

    protected override void OnInitialized()
    {
        orderItemSelections.Clear();

        HashSet<string> cancelledOrderIds = Orders
            .Where(order => order.IsCancel)
            .Select(order => order.OrderId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        orderItemSelections.AddRange(OrderItems.Select(item => new OrderItemSelectionItem
        {
            OrderId = item.OrderId,
            OrderItemId = item.OrderItemId,
            IsCancelled = item.IsCancel,
            IsSelected = false,
            Status = item.Status
        }));

        DateTime defaultDateTime = InitialRescheduledPickupDt ?? DateTime.Now.AddHours(2);
        selectedDate = defaultDateTime.Date;
        selectedTime = defaultDateTime.TimeOfDay;
        selectedTargetDriverId = InitialTargetDriverId ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        validationMessage = string.Empty;

        string[] selectedOrderItemIds = [];

        if (RequiresOrderItemSelection)
        {
            selectedOrderItemIds = orderItemSelections
                .Where(item => item.IsSelected && !item.IsCancelled)
                .Select(item => item.OrderItemId)
                .ToArray();
        }

        if (string.IsNullOrWhiteSpace(reason))
        {
            validationMessage = "Vui lòng nhập lý do.";
            return;
        }

        DateTime? rescheduledPickupDt = null;
        if (IsReschedule)
        {
            if (!selectedDate.HasValue || !selectedTime.HasValue)
            {
                validationMessage = "Vui lòng chọn ngày giờ hẹn lấy lại.";
                return;
            }

            rescheduledPickupDt = selectedDate.Value.Date.Add(selectedTime.Value);
        }

        string? targetDriverId = string.IsNullOrWhiteSpace(selectedTargetDriverId)
            ? null
            : selectedTargetDriverId;

        PickupTaskActionDialogResult result = new(selectedOrderItemIds, reason.Trim(), rescheduledPickupDt, targetDriverId);
        MudDialog.Close(DialogResult.Ok(result));
        await Task.CompletedTask;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static string GetItemStatusLabel(PickupTaskOrderItemStatus status) => status switch
    {
        PickupTaskOrderItemStatus.New => "Mới",
        PickupTaskOrderItemStatus.Picked => "Đã lấy",
        PickupTaskOrderItemStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static Color GetItemStatusColor(PickupTaskOrderItemStatus status) => status switch
    {
        PickupTaskOrderItemStatus.Picked => Color.Success,
        PickupTaskOrderItemStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static string GetDriverOptionLabel(Employee driver)
    {
        return string.IsNullOrWhiteSpace(driver.Code)
            ? driver.Name
            : $"{driver.Code} - {driver.Name}";
    }

    private sealed class OrderItemSelectionItem
    {
        public string OrderId { get; init; } = string.Empty;
        public string OrderItemId { get; init; } = string.Empty;
        public bool IsCancelled { get; init; }
        public bool IsSelected { get; set; }
        public PickupTaskOrderItemStatus Status { get; init; }
    }
}