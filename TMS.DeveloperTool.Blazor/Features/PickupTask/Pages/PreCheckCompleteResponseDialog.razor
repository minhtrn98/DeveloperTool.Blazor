<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Complete preparation: @PickupTaskId</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Outlined="true" Class="pa-3" Style="max-height: 60vh; overflow: auto;">
            <MudText Typo="Typo.body2" Style="white-space: pre-wrap; font-family: Consolas, monospace;">
                @ResponseJson
            </MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Complete" Variant="Variant.Filled" Color="Color.Success">Hoàn tất</MudButton>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string PickupTaskId { get; set; } = string.Empty;

    [Parameter]
    public string ResponseJson { get; set; } = string.Empty;

    private void Close()
    {
        MudDialog.Close();
    }

    private void Complete()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
