@using TMS.DeveloperTool.Blazor.Domain
@using TMS.DeveloperTool.Blazor.Domain.Enums
@using TMS.DeveloperTool.Blazor.Features.PickupTask.Contracts
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Dtos

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Xác nhận lấy đơn: @PickupTaskId</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="PickupMode" @bind-Value="mode" Label="Chế độ lấy hàng" Variant="Variant.Outlined"
                           FullWidth="true">
                    <MudSelectItem T="PickupMode" Value="PickupMode.Full">Lấy tổng</MudSelectItem>
                    <MudSelectItem T="PickupMode" Value="PickupMode.ByOrder">Lấy theo đơn/kiện</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" @bind-Value="totalOrders" Label="Tổng số đơn" Variant="Variant.Outlined"
                                 Min="0" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center">
                <MudCheckBox T="bool" @bind-Value="isShipmentBatch" Label="Shipment Batch" Dense="true" />
            </MudItem>
        </MudGrid>

        @* Orders & Items (parent-child in one table) *@
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Đơn hàng và kiện hàng</MudText>
        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <div class="mb-2 d-flex align-center justify-end">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddOrder">
                    Thêm đơn
                </MudButton>
            </div>

            @if (!orderSelections.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">Không có đơn hàng nào.</MudAlert>
            }
            else
            {
                <div class="mb-2 d-flex align-center">
                    <MudCheckBox T="bool" Value="@AllOrdersSelected" ValueChanged="ToggleAllOrders" Dense="true"
                                 Label="Chọn tất cả đơn hàng" />
                </div>

                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th style="width: 44px;"></th>
                            <th style="width: 44px;"></th>
                            <th style="width: 44px;"></th>
                            <th style="width: 44px;"></th>
                            <th>Mã đơn / Mã kiện</th>
                            <th>Trạng thái</th>
                            <th>Weight</th>
                            <th>L</th>
                            <th>W</th>
                            <th>H</th>
                            <th>Loại hàng</th>
                            <th>Giá trị khai báo</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (OrderSelection order in orderSelections)
                        {
                            List<OrderItemSelection> orderItems = orderItemSelections
                                .Where(i => i.OrderId == order.OrderId)
                                .ToList();

                            <tr>
                                <td>
                                    <MudIconButton
                                    Icon="@(IsOrderExpanded(order.OrderId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                    OnClick="@(() => ToggleOrderExpanded(order.OrderId))" Size="Size.Small"
                                    Color="Color.Default" />
                                </td>
                                <td>
                                    <MudCheckBox T="bool" Value="@order.IsSelected"
                                                 ValueChanged="@((bool v) => ToggleOrderSelection(order.OrderId, v))" Dense="true" />
                                </td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.LibraryAdd"
                                                   OnClick="@(() => AddItem(order.OrderId))" Size="Size.Small" Color="Color.Primary" />
                                </td>
                                <td>
                                    @if (order.IsUserAdded)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveOrder(order.OrderId))" />
                                    }
                                </td>
                                <td>
                                    <MudTextField T="string" Value="@order.OrderId"
                                                  ValueChanged="@((string? v) => UpdateOrderId(order, v))" Variant="Variant.Text"
                                                  Margin="Margin.Dense" />
                                </td>
                                <td>
                                    @if (order.Status.HasValue)
                                    {
                                        <MudChip T="string" Color="@GetOrderStatusColor(order.Status.Value)" Variant="Variant.Outlined" Size="Size.Small">
                                            @GetOrderStatusLabel(order.Status.Value)
                                        </MudChip>
                                    }
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="order.Weight" Variant="Variant.Text"
                                                     Margin="Margin.Dense" HideSpinButtons="true" />
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="order.L" Variant="Variant.Text"
                                                     Margin="Margin.Dense" HideSpinButtons="true" />
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="order.W" Variant="Variant.Text"
                                                     Margin="Margin.Dense" HideSpinButtons="true" />
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="order.H" Variant="Variant.Text"
                                                     Margin="Margin.Dense" HideSpinButtons="true" />
                                </td>
                                <td>
                                    <MudSelect T="GoodsType" @bind-Value="order.GoodsType" Variant="Variant.Text"
                                               Margin="Margin.Dense">
                                        <MudSelectItem T="GoodsType" Value="GoodsType.Document">Document</MudSelectItem>
                                        <MudSelectItem T="GoodsType" Value="GoodsType.Goods">Goods</MudSelectItem>
                                    </MudSelect>
                                </td>
                                <td>
                                    <MudNumericField T="decimal?" @bind-Value="order.DeclaredValue" Variant="Variant.Text"
                                                     Margin="Margin.Dense" HideSpinButtons="true" />
                                </td>
                                <td>
                                    <MudTextField T="string" @bind-Value="order.Note" Variant="Variant.Text"
                                                  Margin="Margin.Dense" />
                                </td>
                            </tr>

                            @if (IsOrderExpanded(order.OrderId))
                            {
                                foreach (OrderItemSelection item in orderItems)
                                {
                                    <tr class="mud-theme-primary-lighten-5">
                                        <td></td>
                                        <td>
                                            <MudCheckBox T="bool" Value="@item.IsSelected"
                                                         ValueChanged="@((bool v) => ToggleItemSelection(item.OrderId, item.OrderItemId, v))"
                                                         Dense="true" />
                                        </td>
                                        <td></td>
                                        <td>
                                            @if (item.IsUserAdded)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                               OnClick="@(() => RemoveItem(item.OrderId, item.OrderItemId))" />
                                            }
                                        </td>
                                        <td>
                                            <MudText Class="pl-6">- @item.OrderItemId</MudText>
                                        </td>
                                        <td>
                                            @if (item.Status.HasValue)
                                            {
                                                <MudChip T="string" Color="@GetItemStatusColor(item.Status.Value)" Variant="Variant.Outlined" Size="Size.Small">
                                                    @GetItemStatusLabel(item.Status.Value)
                                                </MudChip>
                                            }
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal?" @bind-Value="item.Weight" Variant="Variant.Text"
                                                             Margin="Margin.Dense" HideSpinButtons="true" />
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal?" @bind-Value="item.L" Variant="Variant.Text"
                                                             Margin="Margin.Dense" HideSpinButtons="true" />
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal?" @bind-Value="item.W" Variant="Variant.Text"
                                                             Margin="Margin.Dense" HideSpinButtons="true" />
                                        </td>
                                        <td>
                                            <MudNumericField T="decimal?" @bind-Value="item.H" Variant="Variant.Text"
                                                             Margin="Margin.Dense" HideSpinButtons="true" />
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td>
                                            <MudTextField T="string" @bind-Value="item.Note" Variant="Variant.Text"
                                                          Margin="Margin.Dense" />
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>

        @* Workers Section *@
        <MudText Typo="Typo.subtitle1" Class="mt-2 mb-2">Nhân viên lấy hàng (Workers)</MudText>
        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <MudTable Items="@workerSelections" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>Mã NV</MudTh>
                    <MudTh>Tên NV</MudTh>
                    <MudTh>Tỉ lệ đóng góp (%)</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.EmployeeCode</MudTd>
                    <MudTd DataLabel="Name">@context.EmployeeName</MudTd>
                    <MudTd DataLabel="Ratio">
                        <MudNumericField T="decimal" @bind-Value="context.WorkContributionRatio" Variant="Variant.Text"
                                         Margin="Margin.Dense" Min="0" Max="100" HideSpinButtons="true" />
                    </MudTd>
                    <MudTd>
                        @if (!context.IsCurrentDriver)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemoveWorker(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudAutocomplete T="Employee" SearchFunc="SearchAvailableDrivers" ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<Employee>"
                             Label="Thêm tài xế" Variant="Variant.Outlined" FullWidth="true" Clearable="true" MaxItems="20"
                             Class="mt-3" ResetValueOnEmptyText="true" ValueChanged="OnAddWorkerDriver" />
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                @validationMessage
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Hủy</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">Xác nhận lấy đơn</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string PickupTaskId { get; set; } = string.Empty;
    [Parameter] public List<PickupTaskOrderDto> Orders { get; set; } = [];
    [Parameter] public List<PickupTaskOrderItemDto> OrderItems { get; set; } = [];
    [Parameter] public List<Employee> AllEmps { get; set; } = [];
    [Parameter] public Employee? CurrentEmp { get; set; }

    private PickupMode mode = PickupMode.Full;
    private bool isShipmentBatch;
    private int totalOrders;
    private string validationMessage = string.Empty;
    private int nextOrderSequence = 1;

    private readonly List<OrderSelection> orderSelections = [];
    private readonly List<OrderItemSelection> orderItemSelections = [];
    private readonly List<WorkerSelection> workerSelections = [];
    private readonly HashSet<string> expandedOrderIds = [];

    private bool AllOrdersSelected => orderSelections.Count > 0 && orderSelections.All(o => o.IsSelected);

    protected override void OnInitialized()
    {
        orderSelections.Clear();
        orderSelections.AddRange(Orders.Select(o => new OrderSelection
        {
            OrderId = o.OrderId,
            IsSelected = true,
            Status = o.Status
        }));

        orderItemSelections.Clear();
        orderItemSelections.AddRange(OrderItems.Select(oi => new OrderItemSelection
        {
            OrderId = oi.OrderId,
            OrderItemId = oi.OrderItemId,
            Weight = oi.Weight,
            L = oi.L,
            W = oi.W,
            H = oi.H,
            IsSelected = true,
            Status = oi.Status
        }));

        expandedOrderIds.Clear();
        foreach (OrderSelection order in orderSelections)
        {
            expandedOrderIds.Add(order.OrderId);
        }

        totalOrders = Orders.Count;

        // Default current driver as worker
        if (CurrentEmp is not null)
        {
            workerSelections.Add(new WorkerSelection
            {
                EmployeeId = CurrentEmp.EmployeeId,
                EmployeeCode = CurrentEmp.Code,
                EmployeeName = CurrentEmp.Name,
                WorkContributionRatio = 100,
                IsCurrentDriver = true
            });
        }
    }

    private void ToggleAllOrders(bool value)
    {
        foreach (OrderSelection order in orderSelections)
        {
            order.IsSelected = value;
        }

        foreach (OrderItemSelection item in orderItemSelections)
        {
            item.IsSelected = value;
        }
    }

    private void ToggleOrderSelection(string orderId, bool isSelected)
    {
        OrderSelection? order = orderSelections.FirstOrDefault(o => o.OrderId == orderId);
        if (order is null)
        {
            return;
        }

        order.IsSelected = isSelected;

        foreach (OrderItemSelection item in orderItemSelections.Where(i => i.OrderId == orderId))
        {
            item.IsSelected = isSelected;
        }
    }

    private void ToggleItemSelection(string orderId, string orderItemId, bool isSelected)
    {
        OrderItemSelection? item = orderItemSelections.FirstOrDefault(i => i.OrderId == orderId && i.OrderItemId == orderItemId);
        if (item is null)
        {
            return;
        }

        item.IsSelected = isSelected;

        OrderSelection? order = orderSelections.FirstOrDefault(o => o.OrderId == orderId);
        if (order is null)
        {
            return;
        }

        order.IsSelected = orderItemSelections.Any(i => i.OrderId == orderId && i.IsSelected)
            ? true
            : order.IsSelected;
    }

    private bool IsOrderExpanded(string orderId) => expandedOrderIds.Contains(orderId);

    private void ToggleOrderExpanded(string orderId)
    {
        if (!expandedOrderIds.Add(orderId))
        {
            expandedOrderIds.Remove(orderId);
        }
    }

    private void Submit()
    {
        validationMessage = string.Empty;

        if (!ValidateSelections())
        {
            return;
        }

        List<PickedOrderDto> pickedOrders = orderSelections
            .Where(o => o.IsSelected)
            .Select(o => new PickedOrderDto
            {
                OrderId = o.OrderId,
                Weight = o.Weight,
                L = o.L,
                W = o.W,
                H = o.H,
                GoodsType = o.GoodsType,
                DeclaredValue = o.DeclaredValue,
                Note = o.Note,
                IsDirty = false,
                Items = orderItemSelections
                    .Where(i => i.IsSelected && i.OrderId == o.OrderId)
                    .Select(i => new PickedItemDto
                    {
                        OrderId = i.OrderId,
                        OrderItemId = i.OrderItemId,
                        Weight = i.Weight,
                        L = i.L,
                        W = i.W,
                        H = i.H,
                        Note = i.Note,
                        IsDirty = false
                    })
                    .ToList()
            })
            .ToList();

        List<PickedWorkerDto> workers = workerSelections
            .Select(w => new PickedWorkerDto
            {
                EmployeeId = w.EmployeeId,
                EmployeeCode = w.EmployeeCode,
                EmployeeName = w.EmployeeName,
                WorkContributionRatio = w.WorkContributionRatio
            })
            .ToList();

        ConfirmPickupRequest request = new()
        {
            PickupTaskId = PickupTaskId,
            Mode = mode,
            IsShipmentBatch = isShipmentBatch,
            TotalOrders = totalOrders,
            PickedOrders = pickedOrders,
            Workers = workers
        };

        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private Task<IEnumerable<Employee>> SearchAvailableDrivers(string value, CancellationToken cancellationToken)
    {
        HashSet<Guid> existingIds = workerSelections.Select(w => w.EmployeeId).ToHashSet();
        IEnumerable<Employee> available = AllEmps.Where(emp => !existingIds.Contains(emp.EmployeeId));
        IEnumerable<Employee> results = AutocompleteSearchHelper.SearchByLike(available, value, orderByRelevance: false);
        return Task.FromResult(results);
    }

    private void OnAddWorkerDriver(Employee? driver)
    {
        if (driver is null || workerSelections.Any(w => w.EmployeeId == driver.EmployeeId))
        {
            return;
        }

        workerSelections.Add(new WorkerSelection
        {
            EmployeeId = driver.EmployeeId,
            EmployeeCode = driver.Code,
            EmployeeName = driver.Name,
            WorkContributionRatio = 0,
            IsCurrentDriver = false
        });
    }

    private void RemoveWorker(WorkerSelection worker)
    {
        workerSelections.Remove(worker);
    }

    private void AddOrder()
    {
        string newOrderId = GenerateOrderId();

        orderSelections.Add(new OrderSelection
        {
            OrderId = newOrderId,
            IsSelected = true,
            GoodsType = GoodsType.Document,
            IsUserAdded = true
        });

        expandedOrderIds.Add(newOrderId);
        totalOrders = orderSelections.Count;
    }

    private void AddItem(string orderId)
    {
        if (string.IsNullOrWhiteSpace(orderId))
        {
            return;
        }

        orderItemSelections.Add(new OrderItemSelection
        {
            OrderId = orderId,
            OrderItemId = GenerateOrderItemId(orderId),
            IsSelected = true,
            IsUserAdded = true
        });

        expandedOrderIds.Add(orderId);

        OrderSelection? order = orderSelections.FirstOrDefault(o => o.OrderId == orderId);
        if (order is not null)
        {
            order.IsSelected = true;
        }
    }

    private void RemoveOrder(string orderId)
    {
        OrderSelection? order = orderSelections.FirstOrDefault(o => o.OrderId == orderId);
        if (order is null || !order.IsUserAdded)
        {
            return;
        }

        orderSelections.Remove(order);
        orderItemSelections.RemoveAll(i => i.OrderId == orderId);
        expandedOrderIds.Remove(orderId);
        totalOrders = orderSelections.Count;
    }

    private void RemoveItem(string orderId, string orderItemId)
    {
        OrderItemSelection? item = orderItemSelections.FirstOrDefault(i => i.OrderId == orderId && i.OrderItemId ==
orderItemId);
        if (item is null || !item.IsUserAdded)
        {
            return;
        }

        orderItemSelections.Remove(item);
    }

    private void UpdateOrderId(OrderSelection order, string? newOrderId)
    {
        string oldOrderId = order.OrderId;
        string normalizedOrderId = newOrderId?.Trim() ?? string.Empty;

        if (string.Equals(oldOrderId, normalizedOrderId, StringComparison.Ordinal))
        {
            return;
        }

        if (orderSelections.Any(o => !ReferenceEquals(o, order) &&
                                     o.OrderId.Equals(normalizedOrderId, StringComparison.OrdinalIgnoreCase)))
        {
            validationMessage = "Mã đơn hàng bị trùng. Vui lòng kiểm tra lại.";
            return;
        }

        order.OrderId = normalizedOrderId;

        foreach (OrderItemSelection item in orderItemSelections.Where(i => i.OrderId == oldOrderId))
        {
            item.OrderId = normalizedOrderId;

            if (!item.IsUserAdded)
            {
                continue;
            }

            if (item.OrderItemId.Equals(oldOrderId, StringComparison.OrdinalIgnoreCase))
            {
                item.OrderItemId = normalizedOrderId;
            }
            else if (item.OrderItemId.StartsWith($"{oldOrderId}/", StringComparison.OrdinalIgnoreCase))
            {
                string suffix = item.OrderItemId[(oldOrderId.Length + 1)..];
                item.OrderItemId = $"{normalizedOrderId}/{suffix}";
            }
        }

        if (expandedOrderIds.Remove(oldOrderId))
        {
            expandedOrderIds.Add(normalizedOrderId);
        }

        validationMessage = string.Empty;
    }

    private string GenerateOrderId()
    {
        string orderPrefix = PickupTaskId[^6..^0];
        string candidate;
        do
        {
            candidate = $"{orderPrefix}_{nextOrderSequence++:000}";
        }
        while (orderSelections.Any(o => o.OrderId.Equals(candidate, StringComparison.OrdinalIgnoreCase)));

        return candidate;
    }

    private string GenerateOrderItemId(string orderId)
    {
        string orderPrefix = orderId.Trim();

        int nextSequence = orderItemSelections
            .Where(i => i.OrderId == orderId)
            .Select(i => ParseItemSequence(i.OrderItemId, orderPrefix))
            .DefaultIfEmpty(0)
            .Max() + 1;

        string candidate = nextSequence == 1
            ? orderPrefix
            : $"{orderPrefix}/{nextSequence}";
        while (orderItemSelections.Any(i => i.OrderId == orderId && i.OrderItemId.Equals(candidate, StringComparison.OrdinalIgnoreCase)))
        {
            nextSequence++;
            candidate = nextSequence == 1
                ? orderPrefix
                : $"{orderPrefix}/{nextSequence}";
        }

        return candidate;
    }

    private static int ParseItemSequence(string? itemId, string orderPrefix)
    {
        if (string.IsNullOrWhiteSpace(itemId))
        {
            return 0;
        }

        if (itemId.Equals(orderPrefix, StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        string expectedPrefix = $"{orderPrefix}/";
        if (!itemId.StartsWith(expectedPrefix, StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        string suffix = itemId[expectedPrefix.Length..];
        return int.TryParse(suffix, out int value) && value >= 1 ? value : 0;
    }

    private bool ValidateSelections()
    {
        List<OrderSelection> selectedOrders = orderSelections.Where(o => o.IsSelected).ToList();

        if (selectedOrders.Any(o => string.IsNullOrWhiteSpace(o.OrderId)))
        {
            validationMessage = "Mã đơn hàng không được để trống.";
            return false;
        }

        int uniqueOrderCount = selectedOrders
            .Select(o => o.OrderId.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        if (uniqueOrderCount != selectedOrders.Count)
        {
            validationMessage = "Mã đơn hàng bị trùng. Vui lòng kiểm tra lại.";
            return false;
        }

        foreach (OrderSelection order in selectedOrders)
        {
            List<OrderItemSelection> selectedItems = orderItemSelections
                .Where(i => i.IsSelected && i.OrderId == order.OrderId)
                .ToList();

            if (selectedItems.Any(i => string.IsNullOrWhiteSpace(i.OrderItemId)))
            {
                validationMessage = $"Mã kiện của đơn {order.OrderId} không được để trống.";
                return false;
            }

            int uniqueItemCount = selectedItems
                .Select(i => i.OrderItemId.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

            if (uniqueItemCount != selectedItems.Count)
            {
                validationMessage = $"Mã kiện của đơn {order.OrderId} bị trùng. Vui lòng kiểm tra lại.";
                return false;
            }
        }

        return true;
    }

    private static string GetOrderStatusLabel(PickupTaskOrderStatus status) => status switch
    {
        PickupTaskOrderStatus.New => "Mới",
        PickupTaskOrderStatus.Picked => "Đã lấy",
        PickupTaskOrderStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static Color GetOrderStatusColor(PickupTaskOrderStatus status) => status switch
    {
        PickupTaskOrderStatus.Picked => Color.Success,
        PickupTaskOrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static string GetItemStatusLabel(PickupTaskOrderItemStatus status) => status switch
    {
        PickupTaskOrderItemStatus.New => "Mới",
        PickupTaskOrderItemStatus.Picked => "Đã lấy",
        PickupTaskOrderItemStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static Color GetItemStatusColor(PickupTaskOrderItemStatus status) => status switch
    {
        PickupTaskOrderItemStatus.Picked => Color.Success,
        PickupTaskOrderItemStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private sealed class OrderSelection
    {
        public string OrderId { get; set; } = string.Empty;
        public bool IsSelected { get; set; }
        public bool IsUserAdded { get; init; }
        public PickupTaskOrderStatus? Status { get; init; }
        public decimal? Weight { get; set; }
        public decimal? L { get; set; }
        public decimal? W { get; set; }
        public decimal? H { get; set; }
        public GoodsType GoodsType { get; set; } = GoodsType.Document;
        public decimal? DeclaredValue { get; set; }
        public string? Note { get; set; }
    }

    private sealed class OrderItemSelection
    {
        public string OrderId { get; set; } = string.Empty;
