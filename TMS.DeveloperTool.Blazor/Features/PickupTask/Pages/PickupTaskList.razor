@page "/pickup-tasks"
@using TMS.DeveloperTool.Blazor.Domain.Enums
@using TMS.DeveloperTool.Blazor.Infrastructure.Extensions
@using System.Text.Json
@using TMS.DeveloperTool.Blazor.Features.PickupTask.Contracts
@using TMS.DeveloperTool.Blazor.Features.PickupTask.Models
@using TMS.DeveloperTool.Blazor.Features.PickupTask.Services
@using TMS.DeveloperTool.Blazor.Infrastructure.Shared.Dtos
@using TMS.DeveloperTool.Blazor.Services
@inject IDialogService DialogService
@inject OrderRepository OrderRepository
@inject PickupTaskActionService PickupTaskActionService
@inject MyDriverService MyDriverService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<AppPageTitle MenuName="Điều tin" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <div class="d-flex justify-space-between mb-4">
            <MudText Typo="Typo.h4">Danh sách điều tin</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadAsync" Disabled="@isLoading">
                Làm mới
            </MudButton>
        </div>

        <MudTextField @bind-Value="searchId" Label="Tìm theo mã điều tin" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                      Class="mb-3" />

        <MudAutocomplete T="Driver" Value="SelectedDriver" ValueChanged="OnDriverChanged" SearchFunc="SearchDrivers"
                         ToStringFunc="AutocompleteDisplayHelper.GetDisplayString<Driver>" Label="Tài xế" Variant="Variant.Outlined" FullWidth="true" Clearable="true"
                         MaxItems="20" Class="mb-3" />

        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!FilteredPickupTasks.Any())
        {
            <MudAlert Severity="Severity.Info">Không có điều tin.</MudAlert>
        }
        else
        {
            <MudTable Items="@FilteredPickupTasks" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Mã điều tin</MudTh>
                    <MudTh>Tài xế</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Ngày lấy hàng dự kiến</MudTh>
                    <MudTh>Hành động</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="PickupTaskId">
                        <div class="d-flex align-center ga-2">
                            <span>@context.PickupTaskId</span>
                            <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => ApplyTaskIdFilter(context.PickupTaskId))" title="Lọc theo mã điều tin này" />
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Driver">
                        <div class="d-flex align-center ga-2">
                            <span>@FormatDriver(context)</span>
                            <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@(!CanApplyDriverFilter(context))"
                                           OnClick="@(() => ApplyDriverFilterFromTaskAsync(context))" title="Lọc theo tài xế này" />
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@GetStatusColor(context.Status)" Variant="Variant.Outlined"
                                 Size="Size.Small">
                            @GetStatusDescription(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Scheduled Pickup Date">@FormatDate(context.ScheduledPickupDate)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                 Disabled="@IsBusy(context.PickupTaskId)">
                            <ActivatorContent>
                                <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Primary" Size="Size.Small"
                                               Disabled="@IsBusy(context.PickupTaskId)" />
                            </ActivatorContent>

                            <ChildContent>
                                <MudMenuItem OnClick="@(() => HandleActionAsync(context, ActionAccept))">Chấp nhận</MudMenuItem>
                                <MudMenuItem OnClick="@(() => HandleActionAsync(context, ActionArrived))">Đã tới nơi</MudMenuItem>
                                <MudMenuItem OnClick="@(() => HandleActionAsync(context, ActionCancel))">Hủy</MudMenuItem>
                                <MudMenuItem OnClick="@(() => HandleActionAsync(context, ActionReschedule))">Hẹn lấy lại</MudMenuItem>
                                <MudMenuItem OnClick="@(() => HandleActionAsync(context, ActionTransfer))">Chuyển tiếp</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem OnClick="@(() => HandleConfirmPickupAsync(context))">Xác nhận lấy đơn</MudMenuItem>
                                <MudMenuItem OnClick="@(() => HandleShowPickedOrdersAsync(context))">Đơn đã lấy</MudMenuItem>
                                <MudMenuItem OnClick="@(() => HandlePreCheckCompleteAsync(context))">Hoàn tất</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private const string ActionAccept = "Accept";
    private const string ActionArrived = "Arrived";
    private const string ActionCancel = "Cancel";
    private const string ActionReschedule = "Reschedule";
    private const string ActionTransfer = "Transfer";

    private List<PickupTaskInfo> pickupTasks = [];
    private List<Driver> drivers = [];
    private Driver? selectedDriver;
    private string searchId = string.Empty;
    private readonly HashSet<string> processingTaskIds = [];
    private bool isLoading = true;

    private IEnumerable<PickupTaskInfo> FilteredPickupTasks =>
        pickupTasks
            .Where(task => string.IsNullOrWhiteSpace(searchId)
                || task.PickupTaskId.Contains(searchId, StringComparison.OrdinalIgnoreCase))
            .Where(task => selectedDriver == null
                || (!string.IsNullOrWhiteSpace(task.AssignedDriverId)
                    && task.AssignedDriverId.Equals(selectedDriver.DriverId.ToString(), StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(task.AssignedDriverCode)
                    && task.AssignedDriverCode.Equals(selectedDriver.Code, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(task.AssignedDriverName)
                    && task.AssignedDriverName.Equals(selectedDriver.Name, StringComparison.OrdinalIgnoreCase)));

    private Driver? SelectedDriver
    {
        get => selectedDriver;
        set => selectedDriver = value;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDriversAsync();
        await ReloadAsync();
    }

    private async Task LoadDriversAsync()
    {
        drivers = (await MyDriverService.GetAllDriversAsync(CancellationToken.None))
            .OrderBy(x => x.Code)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        try
        {
            pickupTasks = await OrderRepository.GetAllPickupTaskAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDriver(PickupTaskInfo item)
    {
        if (string.IsNullOrWhiteSpace(item.AssignedDriverCode) && string.IsNullOrWhiteSpace(item.AssignedDriverName))
        {
            return "-";
        }

        string code = item.AssignedDriverCode ?? string.Empty;
        string name = item.AssignedDriverName ?? string.Empty;
        return $"{code} - {name}".Trim(' ', '-');
    }

    private Task<IEnumerable<Driver>> SearchDrivers(string value, CancellationToken cancellationToken)
    {
        IEnumerable<Driver> results = AutocompleteSearchHelper.SearchByLike(drivers, value);
        return Task.FromResult(results);
    }

    private Task OnDriverChanged(Driver? driver)
    {
        SelectedDriver = driver;
        return Task.CompletedTask;
    }

    private Task ApplyTaskIdFilter(string taskId)
    {
        searchId = taskId;

        // Auto-select the driver of this task
        PickupTaskInfo? task = pickupTasks.FirstOrDefault(t => t.PickupTaskId == taskId);
        if (task is not null)
        {
            Driver? taskDriver = FindTaskDriver(task);
            if (taskDriver is not null)
            {
                SelectedDriver = taskDriver;
            }
        }

        return Task.CompletedTask;
    }

    private Task ApplyDriverFilterFromTaskAsync(PickupTaskInfo item)
    {
        Driver? taskDriver = FindTaskDriver(item);
        if (taskDriver is null)
        {
            Snackbar.Add("Không tìm thấy tài xế tương ứng trong danh sách filter.", Severity.Warning);
            return Task.CompletedTask;
        }

        SelectedDriver = taskDriver;
        return Task.CompletedTask;
    }

    private bool CanApplyDriverFilter(PickupTaskInfo item)
    {
        Driver? taskDriver = FindTaskDriver(item);
        if (taskDriver is null)
        {
            return false;
        }

        return selectedDriver?.DriverId != taskDriver.DriverId;
    }

    private Driver? FindTaskDriver(PickupTaskInfo item)
    {
        if (!string.IsNullOrWhiteSpace(item.AssignedDriverId)
            && Guid.TryParse(item.AssignedDriverId, out Guid driverId))
        {
            Driver? byId = drivers.FirstOrDefault(driver => driver.DriverId == driverId);
            if (byId is not null)
            {
                return byId;
            }
        }

        if (!string.IsNullOrWhiteSpace(item.AssignedDriverCode))
        {
            Driver? byCode = drivers.FirstOrDefault(driver =>
                !string.IsNullOrWhiteSpace(driver.Code)
                && driver.Code.Equals(item.AssignedDriverCode, StringComparison.OrdinalIgnoreCase));
            if (byCode is not null)
            {
                return byCode;
            }
        }

        if (!string.IsNullOrWhiteSpace(item.AssignedDriverName))
        {
            return drivers.FirstOrDefault(driver =>
                !string.IsNullOrWhiteSpace(driver.Name)
                && driver.Name.Equals(item.AssignedDriverName, StringComparison.OrdinalIgnoreCase));
        }

        return null;
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-";
    }

    private static Color GetStatusColor(string? status)
    {
        if (!TryParseStatus(status, out PickupTaskStatusId statusId))
        {
            return Color.Default;
        }

        return statusId switch
        {
            PickupTaskStatusId.WaitingForAssignment => Color.Warning,
            PickupTaskStatusId.WaitingForAcceptance => Color.Warning,
            PickupTaskStatusId.InTransit => Color.Info,
            PickupTaskStatusId.Arrived => Color.Primary,
            PickupTaskStatusId.PickingUp => Color.Info,
            PickupTaskStatusId.CreatingOrder => Color.Primary,
            PickupTaskStatusId.Completed => Color.Success,
            PickupTaskStatusId.PickupFailed => Color.Error,
            PickupTaskStatusId.Cancelled => Color.Dark,
            PickupTaskStatusId.TransferredToPostOffice => Color.Secondary,
            PickupTaskStatusId.WaitingForVehicleRental => Color.Warning,
            PickupTaskStatusId.VehicleRentalInProgress => Color.Info,
            _ => Color.Default
        };
    }

    private static string GetStatusDescription(string? status)
    {
        if (!TryParseStatus(status, out PickupTaskStatusId statusId))
        {
            return status ?? string.Empty;
        }

        return statusId.ToDescriptionString();
    }

    private static bool TryParseStatus(string? status, out PickupTaskStatusId statusId)
    {
        statusId = default;
        if (!short.TryParse(status, out short statusValue))
        {
            return false;
        }

        if (!Enum.IsDefined(typeof(PickupTaskStatusId), (int)statusValue))
        {
            return false;
        }

        statusId = (PickupTaskStatusId)statusValue;
        return true;
    }

    private bool IsBusy(string pickupTaskId)
    {
        return processingTaskIds.Contains(pickupTaskId);
    }

    private async Task<PickupTaskActionDialogResult?> ShowActionDialogAsync(PickupTaskInfo item, string action)
    {
        List<PickupTaskOrderInfo> orders = [];
        List<PickupTaskOrderItemInfo> orderItems = [];
        if (action is ActionCancel or ActionReschedule)
        {
            orders = await OrderRepository.GetOrdersByPickupTaskIdAsync(item.PickupTaskId);
            orderItems = await OrderRepository.GetOrderItemsByPickupTaskIdAsync(item.PickupTaskId);
        }

        List<Driver> transferDrivers = drivers
            .Where(driver => selectedDriver == null || driver.DriverId != selectedDriver.DriverId)
            .ToList();

        DialogParameters parameters = new()
        {
            { nameof(PickupTaskActionDialog.ActionName), action },
            { nameof(PickupTaskActionDialog.PickupTaskId), item.PickupTaskId },
            { nameof(PickupTaskActionDialog.Orders), orders },
            { nameof(PickupTaskActionDialog.OrderItems), orderItems },
            { nameof(PickupTaskActionDialog.InitialRescheduledPickupDt), GetSuggestedRescheduleTime(item) },
            { nameof(PickupTaskActionDialog.TransferDrivers), transferDrivers },
            { nameof(PickupTaskActionDialog.InitialTargetDriverId), string.Empty }
        };

        DialogOptions options = new()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        IDialogReference dialog = await DialogService.ShowAsync<PickupTaskActionDialog>(GetDialogTitle(action), parameters,
options);
        DialogResult? result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not PickupTaskActionDialogResult dialogResult)
        {
            return null;
        }

        return dialogResult;
    }

    private static DateTime GetSuggestedRescheduleTime(PickupTaskInfo item)
    {
        DateTime baseTime = item.ScheduledPickupDate?.ToLocalTime() ?? DateTime.Now;
        return baseTime.AddHours(2);
    }

    private static string GetDialogTitle(string action)
    {
        return action switch
        {
            ActionCancel => "Hủy điều tin",
            ActionReschedule => "Hẹn lấy lại",
            ActionTransfer => "Chuyển tiếp điều tin",
            _ => "Cập nhật điều tin"
        };
    }

    private async Task HandlePreCheckCompleteAsync(PickupTaskInfo item)
    {
        if (!processingTaskIds.Add(item.PickupTaskId))
        {
            return;
        }

        try
        {
            string bearerToken = selectedDriver?.BearerToken ?? string.Empty;
            if (string.IsNullOrWhiteSpace(bearerToken))
            {
                Snackbar.Add("Vui lòng chọn tài xế có Bearer token trước khi thao tác.", Severity.Warning);
                return;
            }

            JsonElement response = await PickupTaskActionService.GetCompletePreparationAsync(item.PickupTaskId, bearerToken);

            DialogParameters parameters = new()
            {
                { nameof(PreCheckCompleteResponseDialog.PickupTaskId), item.PickupTaskId },
                { nameof(PreCheckCompleteResponseDialog.ResponseJson), FormatResponseJson(response) }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

            IDialogReference dialog = await DialogService.ShowAsync<PreCheckCompleteResponseDialog>("Complete preparation data", parameters, options);
            DialogResult? result = await dialog.Result;

            if (result?.Canceled == false && result.Data is bool shouldComplete && shouldComplete)
            {
                await PickupTaskActionService.CompletePickupAsync(item.PickupTaskId, bearerToken);
                await ReloadAsync();
                Snackbar.Add($"Hoàn tất điều tin {item.PickupTaskId} thành công.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi khi get complete preparation: {ex.Message}", Severity.Error);
        }
        finally
        {
            processingTaskIds.Remove(item.PickupTaskId);
        }
    }

    private static string FormatResponseJson(JsonElement response)
    {
        return JsonSerializer.Serialize(response, new JsonSerializerOptions
        {
            WriteIndented = true
        });
    }

    private async Task HandleConfirmPickupAsync(PickupTaskInfo item)
    {
        if (!processingTaskIds.Add(item.PickupTaskId))
        {
            return;
        }

        try
        {
            string bearerToken = selectedDriver?.BearerToken ?? string.Empty;
            if (string.IsNullOrWhiteSpace(bearerToken))
            {
                Snackbar.Add("Vui lòng chọn tài xế có Bearer token trước khi thao tác.", Severity.Warning);
                return;
            }

            List<PickupTaskOrderInfo> orders = await OrderRepository.GetOrdersByPickupTaskIdAsync(item.PickupTaskId);
            List<PickupTaskOrderItemInfo> orderItems = await OrderRepository.GetOrderItemsByPickupTaskIdAsync(item.PickupTaskId);

            DialogParameters parameters = new()
            {
                { nameof(ConfirmPickupDialog.PickupTaskId), item.PickupTaskId },
                { nameof(ConfirmPickupDialog.Orders), orders },
                { nameof(ConfirmPickupDialog.OrderItems), orderItems },
                { nameof(ConfirmPickupDialog.AllDrivers), drivers },
                { nameof(ConfirmPickupDialog.CurrentDriver), selectedDriver }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

            IDialogReference dialog = await DialogService.ShowAsync<ConfirmPickupDialog>("Xác nhận lấy đơn", parameters, options);
            DialogResult? result = await dialog.Result;

            if (result?.Canceled != false || result.Data is not ConfirmPickupRequest request)
            {
                return;
            }

            await PickupTaskActionService.ConfirmPickupAsync(request, bearerToken);
            await ReloadAsync();
            Snackbar.Add($"Xác nhận lấy đơn {item.PickupTaskId} thành công.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi khi xác nhận lấy đơn: {ex.Message}", Severity.Error);
        }
        finally
        {
            processingTaskIds.Remove(item.PickupTaskId);
        }
    }

    private async Task HandleShowPickedOrdersAsync(PickupTaskInfo item)
    {
        if (!processingTaskIds.Add(item.PickupTaskId))
        {
            return;
        }

        try
        {
            List<PickupTaskOrderDraft> drafts = await OrderRepository.GetPickupTaskOrderDraftsByPickupTaskIdAsync(item.PickupTaskId);

            DialogParameters parameters = new()
            {
                { nameof(PickupTaskOrderDraftsDialog.PickupTaskId), item.PickupTaskId },
                { nameof(PickupTaskOrderDraftsDialog.Drafts), drafts }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

            IDialogReference dialog = await DialogService.ShowAsync<PickupTaskOrderDraftsDialog>("Đơn đã lấy", parameters, options);
            await dialog.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi khi tải dữ liệu đơn đã lấy: {ex.Message}", Severity.Error);
        }
        finally
        {
            processingTaskIds.Remove(item.PickupTaskId);
        }
    }

    private async Task HandleActionAsync(PickupTaskInfo item, string action)
    {
        if (!processingTaskIds.Add(item.PickupTaskId))
        {
            return;
        }

        try
        {
            string bearerToken = selectedDriver?.BearerToken ?? string.Empty;
            if (string.IsNullOrWhiteSpace(bearerToken))
            {
                Snackbar.Add("Vui lòng chọn tài xế có Bearer token trước khi thao tác.", Severity.Warning);
                return;
            }

            PickupTaskActionDialogResult? dialogResult = null;
            if (action is ActionCancel or ActionReschedule or ActionTransfer)
            {
                dialogResult = await ShowActionDialogAsync(item, action);
                if (dialogResult is null)
                {
                    return;
                }
            }

            switch (action)
            {
                case ActionAccept:
                    await PickupTaskActionService.AcceptAsync(item.PickupTaskId, bearerToken);
                    break;
                case ActionArrived:
                    await PickupTaskActionService.ConfirmArrivedAsync(item.PickupTaskId, bearerToken);
                    break;
                case ActionCancel:
                    await PickupTaskActionService.DriverCancelAsync(
                        item.PickupTaskId,
                        bearerToken,
                        dialogResult!.Reason,
                        dialogResult.OrderItemIds);
                    break;
                case ActionReschedule:
                    await PickupTaskActionService.RescheduleAsync(
                        item.PickupTaskId,
                        bearerToken,
                        dialogResult!.RescheduledPickupDt ?? GetSuggestedRescheduleTime(item),
                        dialogResult.Reason,
                        dialogResult.OrderItemIds);
                    break;
                case ActionTransfer:
                    await PickupTaskActionService.TransferAsync(
                        item.PickupTaskId,
                        bearerToken,
                        dialogResult!.Reason,
                        dialogResult.TargetDriverId);
                    break;
                default:
                    Snackbar.Add($"Hành động '{action}' không hợp lệ.", Severity.Warning);
                    return;
            }

            await ReloadAsync();

            Snackbar.Add($"{action} điều tin {item.PickupTaskId} thành công.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi khi {action.ToLowerInvariant()} điều tin: {ex.Message}", Severity.Error);
        }
        finally
        {
            processingTaskIds.Remove(item.PickupTaskId);
        }
    }
}
