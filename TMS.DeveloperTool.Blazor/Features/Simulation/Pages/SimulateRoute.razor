@page "/simulate-route"
@using Microsoft.EntityFrameworkCore
@using TMS.DeveloperTool.Blazor.Features.Routing.Services
@using TMS.DeveloperTool.Blazor.Features.Simulation.Services
@implements IDisposable
@inject FleetRepository FleetRepository
@inject RouteCheckPointTemplateService RouteCheckPointTemplateService
@inject FakeVehicleTransportService FakeVehicleTransportService
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext

<AppPageTitle MenuName="Mô phỏng lộ trình" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <MudText Typo="Typo.h4">Mô phỏng lộ trình</MudText>
        </div>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <MudStack Spacing="3">
                <MudAutocomplete T="string"
                    @bind-Value="SelectedVehicle"
                    SearchFunc="@SearchEmpty"
                    Label="Chọn xe"
                    AdornmentColor="Color.Primary"
                    Variant="Variant.Outlined"
                    Clearable="true"
                    MaxItems="1000"
                >
                    <NoItemsTemplate>
                        <MudText Align="Align.Center" Class="px-4 py-1">
                            Không tìm thấy dữ liệu
                        </MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                @if (Templates.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        Chưa có lộ trình mẫu nào. Vui lòng tạo lộ trình mẫu trước.
                    </MudAlert>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@GoToRoutingConfig" Size="Size.Small">
                        Tới cấu hình lộ trình
                    </MudButton>
                }
                else if (SelectedVehicle != string.Empty)
                {
                    <MudSelect T="Guid" @bind-Value="SelectedTemplate" Label="Chọn lộ trình mẫu" Variant="Variant.Outlined">
                        @foreach (var template in Templates)
                        {
                            <MudSelectItem Value="@template.Id">@template.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@StartAsync" Disabled="@IsOperationInProgress" Size="Size.Small">
                        @if (IsOperationInProgress)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Đang xử lý...</MudText>
                        }
                        else
                        {
                            <MudText>Bắt đầu mô phỏng</MudText>
                        }
                    </MudButton>
                }
            </MudStack>
        }
    </MudPaper>
</MudContainer>


@code {
    private string SelectedVehicle { get; set; } = string.Empty;
    private Guid SelectedTemplate { get; set; } = Guid.Empty;
    private HashSet<string> Vehicles { get; set; } = [];
    private List<RouteCheckPointTemplate> Templates { get; set; } = [];
    private bool IsOperationInProgress { get; set; } = false;
    private bool isLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            Vehicles = await DbContext.Vehicles
                .AsNoTracking()
                .Select(v => v.LicensePlate)
                .ToHashSetAsync(StringComparer.OrdinalIgnoreCase);
            Templates = await RouteCheckPointTemplateService.GetAllAsync();
            SelectedTemplate = Templates.FirstOrDefault()?.Id ?? Guid.Empty;
        }
        finally
        {
            isLoading = false;
        }
    }

    protected Task<IEnumerable<string>> SearchEmpty(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<string>>(Vehicles);
        }

        string formatValue = value.Replace(".", "").Replace("-", "");

        var results = Vehicles.OrderByDescending(x => x.Contains(formatValue, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult<IEnumerable<string>>(results);
    }

    private async Task StartAsync()
    {
        if (string.IsNullOrEmpty(SelectedVehicle))
            return;

        IsOperationInProgress = true;
        try
        {
            await FakeVehicleTransportService.StartAsync(SelectedVehicle, SelectedTemplate);
        }
        finally
        {
            IsOperationInProgress = false;
        }
    }

    public void Dispose()
    {
    }

    private void GoToRoutingConfig()
    {
        NavigationManager.NavigateTo("/routing-config");
    }
}